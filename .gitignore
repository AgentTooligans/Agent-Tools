.DS_Store
*.log

# Ignore certain files and directories
.claude/*
.claude/**
.claude
.gitignore

# Graphify knowledge graph. Fully derived output — not committed. A fresh
# clone regenerates it (including LLM-derived labels/cache) by running
# graphify/agent-tools refresh.
graphify-out/

# code-review-graph index (generated, rebuildable)
.code-review-graph/

# ---------------------------------------------------------------------------
# Private / machine-specific. None of this belongs in a public repo.
# ---------------------------------------------------------------------------
# Per-machine agent config. `agent-tools init` writes .claude/settings.json for
# YOUR machine; committing it would push your hook setup onto everyone else.
.claude/
.codex/
.cursor/
.gemini/
.antigravity/

# Working notes from individual sessions. Useful locally, meaningless to
# anyone else, and they tend to name whatever else you were working on.
docs/session-notes/

# Other tools' per-repo indexes and caches.
.code-review-graph/
.token-savior/
.serena/

# OS + editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python bytecode from running the helper scripts
__pycache__/
*.pyc

# token-savior index cache (generated, rebuildable)
.token-savior-cache.json
