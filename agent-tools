#!/usr/bin/env bash
# ===========================================================================
# agent-tools — set up graphify + agentmemory for ANY project, on any platform.
#
# One self-contained file. No dependencies beyond bash, python3, and the tools
# it installs.
#
#   agent-tools doctor            what's installed / what's wrong  (safe)
#   agent-tools install-machine   one-time per COMPUTER
#   agent-tools init              one-time per PROJECT (run inside the repo)
#   agent-tools refresh           update this project's graph, in order
#   agent-tools help              long help, with the reasoning
#
# PLATFORM SUPPORT
#   macOS          full         launchd service
#   Linux          full         systemd --user service
#   WSL2           full         systemd --user if enabled, else manual start
#   Windows native PARTIAL      graphify only — see `agent-tools help`
#
#   Native Windows is limited by agentmemory upstream, not by this script: its
#   engine has no PowerShell/scoop/winget installer and `agentmemory connect` is
#   unsupported there. Upstream's own advice is WSL2, and so is ours.
#
# Every default here comes from an observed failure. The ones that will bite you
# if changed are marked LAW.
# ===========================================================================
set -uo pipefail
VERSION=3.1.0

BIN="$HOME/.local/bin"
AM="$HOME/.agentmemory"

c_ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
c_bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; }
c_warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }
hdr()    { printf '\n\033[1m== %s ==\033[0m\n' "$1"; }
have()   { command -v "$1" >/dev/null 2>&1; }

# WSL inherits the WINDOWS PATH, so `node`/`npm` frequently resolve to
# /mnt/c/Program Files/nodejs/... — Windows binaries running under Linux paths.
# Installing through them puts packages in the WINDOWS npm prefix
# (/mnt/c/Users/<you>/AppData/Roaming/npm) and any Linux service pointed at the
# result FAILS while every check still looks green. Observed on real WSL2
# 2026-07-29: agentmemory "installed" to /mnt/c/... and its systemd unit died.
# So inside WSL a Windows-hosted binary counts as NOT INSTALLED.
have_native() {
    local p; p="$(command -v "$1" 2>/dev/null)" || return 1
    [ -n "$p" ] || return 1
    if [ "$PLATFORM" = wsl ]; then
        case "$p" in /mnt/*) return 1 ;; esac
    fi
    return 0
}
# Where a command actually lives, for honest reporting.
where_is() { command -v "$1" 2>/dev/null || echo "not found"; }

export PATH="$BIN:/opt/homebrew/bin:/usr/local/bin:$PATH"

# ---------------------------------------------------------------------------
# Consent for installs.
#   default    ask before installing anything
#   --yes/-y   install everything without asking (CI, unattended)
#   --no-install  never install; just report what is missing
# Non-interactive with no --yes SKIPS rather than blocks: a script that hangs
# forever waiting on a prompt nobody can answer is worse than one that stops.
# ---------------------------------------------------------------------------
ASSUME_YES=0
NO_INSTALL=0

# ---------------------------------------------------------------------------
# Memory backend. Two tools do this job and they must not both be active:
# each hooks the session lifecycle, so running both means double capture and
# double per-tool-call overhead.
#
#   claude-mem   default. Runs a worker on :37701 (start with `npx claude-mem
#                start` — no launchd/systemd unit needed, and no cwd trap),
#                injects context at session start, ~3.4x the adoption. No bulk
#                importer: it starts from install day. Ships /learn-codebase to
#                ingest a repo.
#   agentmemory  opt-in. Needs a supervised server whose WORKING DIRECTORY
#                decides the store location, but has `import-jsonl` to rebuild
#                from past transcripts.
#
# Resolution order: --memory flag > saved choice > default.
# ---------------------------------------------------------------------------
AT_CONFIG_DIR="$HOME/.config/agent-tools"
AT_CONFIG="$AT_CONFIG_DIR/config"
MEMORY_DEFAULT="claude-mem"
MEMORY_BACKEND=""
SKIP_CAVEMAN=0
for _a in "$@"; do
    case "$_a" in
        --memory=*) MEMORY_BACKEND="${_a#--memory=}" ;;
        --no-caveman) SKIP_CAVEMAN=1 ;;
    esac
done
if [ -z "$MEMORY_BACKEND" ] && [ -f "$AT_CONFIG" ]; then
    MEMORY_BACKEND="$(sed -n 's/^memory_backend=//p' "$AT_CONFIG" 2>/dev/null | tail -1)"
fi
MEMORY_BACKEND="${MEMORY_BACKEND:-$MEMORY_DEFAULT}"
case "$MEMORY_BACKEND" in
    claude-mem|agentmemory|none) ;;
    *) printf '  unknown --memory value: %s (use claude-mem | agentmemory | none)\n' "$MEMORY_BACKEND"; exit 2 ;;
esac
remember_backend() {
    mkdir -p "$AT_CONFIG_DIR" 2>/dev/null
    if [ -f "$AT_CONFIG" ]; then
        grep -v '^memory_backend=' "$AT_CONFIG" > "$AT_CONFIG.tmp" 2>/dev/null || true
        mv "$AT_CONFIG.tmp" "$AT_CONFIG" 2>/dev/null
    fi
    printf 'memory_backend=%s\n' "$1" >> "$AT_CONFIG"
}

# Detect either backend regardless of which is selected, so we can warn when
# both are present (the user asked for a loud warning, not a hard block).
cm_installed() { have claude-mem || [ -d "$HOME/.claude-mem" ]; }
am_installed() { have agentmemory || [ -d "$AM/data" ]; }

# INSTALLED is not the problem — ACTIVE is. A backend that is present but has
# its hooks disabled and its service stopped costs nothing and is a useful
# archive. Only two *capturing* backends duplicate work. Warning on mere
# presence cries wolf at exactly the person who did the right thing.
cm_active() { curl -sf -m 3 http://127.0.0.1:37701 >/dev/null 2>&1; }
am_active() {
    curl -sf -m 3 http://localhost:3111/agentmemory/health >/dev/null 2>&1 && return 0
    # Plugin enabled (not merely installed) also means hooks fire.
    have claude || return 1
    claude plugin list 2>/dev/null | grep -A3 "agentmemory@agentmemory" | grep -qi "enabled"
}
for _a in "$@"; do
    case "$_a" in
        -y|--yes)     ASSUME_YES=1 ;;
        --no-install) NO_INSTALL=1 ;;
    esac
done

confirm() {   # confirm "<what>" -> 0 = go ahead
    if [ "$NO_INSTALL" = 1 ]; then c_warn "missing: $1  (--no-install set; skipping)"; return 1; fi
    if [ "$ASSUME_YES" = 1 ]; then c_warn "installing: $1"; return 0; fi

    # Is there REALLY a terminal? `[ -r /dev/tty ]` is not enough: in a container
    # the device node exists and looks readable, but opening it fails with ENXIO
    # when there is no controlling terminal. That false positive made a
    # non-interactive run take the prompt path and install without consent.
    local src=""
    if [ -t 0 ]; then src="stdin"
    elif { : < /dev/tty; } 2>/dev/null; then src="tty"; fi

    if [ -z "$src" ]; then
        c_warn "missing: $1  (non-interactive — re-run with --yes to install)"
        return 1
    fi

    printf '  \033[33m?\033[0m Install %s? [Y/n] ' "$1"
    local reply=""
    # FAIL CLOSED: if the read fails (EOF, closed pipe, unusable tty) that is a
    # non-answer and must mean "no". Only a successful read counts as consent —
    # an empty reply then is the user pressing Enter, which is the [Y/n] default.
    if [ "$src" = tty ]; then
        read -r reply < /dev/tty || { echo; c_warn "no answer — skipping $1"; return 1; }
    else
        read -r reply || { echo; c_warn "no answer — skipping $1"; return 1; }
    fi
    case "$reply" in [nN]*) c_warn "skipped: $1"; return 1 ;; *) return 0 ;; esac
}

# ---------------------------------------------------------------------------
# Platform detection. Everything platform-specific dispatches on PLATFORM.
# ---------------------------------------------------------------------------
detect_platform() {
    local s; s="$(uname -s 2>/dev/null || echo unknown)"
    case "$s" in
        Darwin) echo macos ;;
        Linux)
            # WSL reports Linux; the giveaway is "microsoft" in the kernel
            # string (WSL1 and WSL2 both) or the distro env var.
            if grep -qiE "microsoft|wsl" /proc/version 2>/dev/null || [ -n "${WSL_DISTRO_NAME:-}" ]; then
                echo wsl
            else
                echo linux
            fi ;;
        MINGW*|MSYS*|CYGWIN*) echo windows ;;
        *) echo unknown ;;
    esac
}
PLATFORM="$(detect_platform)"

# systemd --user is not a given: WSL needs systemd=true in /etc/wsl.conf, and
# some containers/distros run without it. Check before relying on it.
has_systemd() {
    have systemctl || return 1
    [ -d /run/systemd/system ] || return 1
    systemctl --user show-environment >/dev/null 2>&1
}

# pgrep is absent on Git Bash; fall back to ps.
proc_running() {
    if have pgrep; then pgrep -f "$1" >/dev/null 2>&1
    else ps -ef 2>/dev/null | grep -E "$1" | grep -qv grep; fi
}

# Is a graphify run active IN THIS REPO?
#
# The old check matched any graphify process anywhere on the machine, so
# indexing project A blocked a refresh in unrelated project B — observed
# 2026-07-29. Two writers on ONE graphify-out/ is the real hazard, so scope the
# check by the process's working directory.
#
# If a pid's cwd cannot be determined we treat it as blocking: a false "wait"
# costs you a minute, a false "go ahead" can corrupt a graph.
# The bracket around the y is deliberate. `$(pgrep -f "$GRAPHIFY_PROCS")` forks
# a subshell whose OWN command line contains this pattern text, so a literal
# pattern matches that subshell — and its cwd is whatever repo you are checking,
# producing a phantom "a run is active in this repo" (seen 2026-07-29).
# "graphif[y]" still matches the string "graphify" as a regex, but the pattern
# text itself does not, so the subshell is invisible to it.
GRAPHIFY_PROCS="graphif[y] (extract|update|label|cluster-only|watch)"
graphify_busy_here() {
    local repo="$1" pid cwd
    have pgrep || { proc_running "$GRAPHIFY_PROCS"; return $?; }
    for pid in $(pgrep -f "$GRAPHIFY_PROCS" 2>/dev/null); do
        [ "$pid" = "$$" ] && continue
        [ "$pid" = "$PPID" ] && continue
        cwd=""
        if [ -r "/proc/$pid/cwd" ]; then
            cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null)"
        elif have lsof; then
            cwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
        fi
        if [ -z "$cwd" ]; then
            BUSY_WHERE="(unknown cwd, pid $pid)"; return 0
        fi
        case "$cwd" in
            "$repo"|"$repo"/*) BUSY_WHERE="$cwd (pid $pid)"; return 0 ;;
        esac
    done
    return 1
}

# Pick a python that actually RUNS, not merely one that exists.
#
# On Windows, `python3` is usually the Microsoft Store "App Execution Alias" —
# a stub on PATH that is NOT an interpreter. It answers every invocation with
# "Python was not found; run without arguments to install from the Microsoft
# Store", so an existence check picks it over the real `python` sitting right
# next to it. Observed in Git Bash on Windows 11, 2026-07-29:
#     python3 -> AppData/Local/Microsoft/WindowsApps/python3    (stub, broken)
#     python  -> AppData/Local/Programs/Python/Python312/python (real, 3.12.10)
# `py` is the Windows Python launcher, a reasonable last resort.
_pick_python() {
    local c
    for c in python3 python py; do
        command -v "$c" >/dev/null 2>&1 || continue
        "$c" -c "pass" >/dev/null 2>&1 && { printf '%s' "$c"; return 0; }
    done
    # Last resort: a uv-managed interpreter. uv is already a dependency here, so
    # this needs no extra package manager and works on every platform — useful
    # on Windows, where a system Python is not a given.
    if command -v uv >/dev/null 2>&1; then
        local up; up="$(uv python find 2>/dev/null | head -1)"
        if [ -n "$up" ] && [ -x "$up" ] && "$up" -c "pass" >/dev/null 2>&1; then
            printf '%s' "$up"; return 0
        fi
    fi
    printf ''
}
PY="$(_pick_python)"

SERVICE_LABEL="com.agentmemory.server"
PLIST="$HOME/Library/LaunchAgents/$SERVICE_LABEL.plist"
UNIT_DIR="$HOME/.config/systemd/user"
UNIT="$UNIT_DIR/agentmemory.service"

# ---------------------------------------------------------------------------
