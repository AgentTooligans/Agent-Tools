# ---------------------------------------------------------------------------
# pocock — grill-me / grilling / handoff / wait-what from mattpocock/skills.
#
# INSTALL MECHANISM: the same `npx skills add ... -g` path caveman already
# uses, so the skills land in ~/.agents/skills and are symlinked into every
# agent's own skills directory. That is deliberate: the Claude Code plugin
# route would reach Claude Code only, and half this repo's point is that the
# other agents get the same treatment.
#
# LAW: --skill takes ONE name. Verified 2026-08-19 against skills CLI:
# `--skill 'a,b,c'` prints "No matching skills found for: a,b,c", lists the
# repo's skills and installs NOTHING, while exiting 0. A comma-separated list
# is a silent no-op, not an error. Repeat the flag instead.
# ---------------------------------------------------------------------------
pocock_dir() { printf '%s/.agents/skills' "$HOME"; }

# On native Windows the skills CLI's default SYMLINK into each agent directory
# needs either Administrator or Developer Mode; without one it fails, and on a
# filesystem without symlink support it can appear to succeed and leave the
# agent directories empty. `--copy` writes real files instead. Harmless
# elsewhere, so it is applied only where it is needed.
skills_copy_flag() { [ "$PLATFORM" = windows ] && printf -- '--copy'; return 0; }

# Installed means ALL of them: grill-me without grilling is a dead end, so a
# partial install is a broken install and must not report success.
pocock_installed() {
    local sk
    printf '%s\n' "$POCOCK_SKILLS" | while IFS= read -r sk; do
        [ -n "$sk" ] || continue
        [ -d "$(pocock_dir)/$sk" ] || exit 1
    done
}
pocock_missing() {     # prints the ones that are absent, one per line
    local sk
    printf '%s\n' "$POCOCK_SKILLS" | while IFS= read -r sk; do
        [ -n "$sk" ] || continue
        [ -d "$(pocock_dir)/$sk" ] || printf '%s\n' "$sk"
    done
}

# Content fingerprint of the installed skills. Used to tell a real update from
# a no-op, because the CLI's exit status cannot. Falls back to size+mtime when
# no checksum tool is around, which is enough to detect "something changed".
pocock_fingerprint() {
    local d; d="$(pocock_dir)"
    [ -d "$d" ] || { printf 'none'; return 0; }
    local sk files=""
    for sk in $(printf '%s\n' "$POCOCK_SKILLS"); do
        [ -d "$d/$sk" ] && files="$files $d/$sk"
    done
    [ -n "$files" ] || { printf 'none'; return 0; }
    # -L so we hash the real files, not the symlinks the CLI creates.
    if have shasum; then
        find -L $files -type f 2>/dev/null | sort | xargs shasum 2>/dev/null | shasum | awk '{print $1}'
    elif have sha256sum; then
        find -L $files -type f 2>/dev/null | sort | xargs sha256sum 2>/dev/null | sha256sum | awk '{print $1}'
    else
        find -L $files -type f -exec ls -l {} \; 2>/dev/null | awk '{print $5, $9}' | sort | cksum
    fi
}

# Build the repeated --skill flags. Newline-delimited input, so a skill name
# with a space in it would still survive.
_pocock_flags() {
    local sk
    printf '%s\n' "$POCOCK_SKILLS" | while IFS= read -r sk; do
        [ -n "$sk" ] || continue
        printf -- '--skill\n%s\n' "$sk"
    done
}

install_pocock() {
    hdr "pocock (grill-me · handoff · wait-what)"
    if [ "$SKIP_POCOCK" = 1 ]; then c_warn "skipped (--no-pocock)"; return 0; fi
    if ! node_ok; then
        c_warn "needs Node >= $NODE_MIN for npx — skipping (everything else still works)"
        return 0
    fi
    if pocock_installed && [ "$NO_INSTALL" = 1 ] && [ "$ASSUME_YES" = 0 ]; then
        c_ok "pocock skills already installed (left as-is)"; return 0
    fi
    pocock_installed || confirm "the pocock skills (4 markdown skills; no MCP server, no hooks)" || return 0

    # Same neutral-cwd trick as caveman: without -g the CLI writes
    # $PWD/.agents/skills, and we do not want that in whatever repo you
    # happened to be standing in.
    local neutral; neutral="$(mktemp -d 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")"
    local flags; flags="$(_pocock_flags)"
    # Deliberate word splitting on a newline-delimited list (SC2046/SC2086).
    # shellcheck disable=SC2046,SC2086
    ( cd "$neutral" && IFS='
' && npx -y skills add "$POCOCK_REPO" $flags --agent '*' -g -y $(skills_copy_flag) >/dev/null 2>&1 )
    [ -d "$neutral" ] && rm -rf "$neutral" 2>/dev/null

    local missing; missing="$(pocock_missing)"
    if [ -z "$missing" ]; then
        c_ok "pocock skills installed globally (~/.agents/skills, all agents)"
        echo "        /grill-me · /handoff · /wait-what   (grilling backs grill-me)"
    else
        c_bad "these did not install: $(printf '%s' "$missing" | tr '\n' ' ')"
        c_warn "retry: npx -y skills add $POCOCK_REPO --skill grill-me --skill grilling --skill handoff --skill wait-what --agent '*' -g -y"
    fi
}

pocock_cmd() {
    case "${1:-status}" in
        install) SKIP_POCOCK=0; install_pocock ;;
        status)
            if pocock_installed; then
                c_ok "pocock skills installed (~/.agents/skills)"
                local sk
                printf '%s\n' "$POCOCK_SKILLS" | while IFS= read -r sk; do
                    [ -n "$sk" ] && echo "        $sk"
                done
                echo
                echo "  In a session:  /grill-me · /handoff · /wait-what"
                echo "  grilling is the engine behind /grill-me, not something you call."
            else
                local missing; missing="$(pocock_missing)"
                c_warn "missing: $(printf '%s' "$missing" | tr '\n' ' ')"
                c_warn "install: agent-tools install pocock"
            fi ;;
        update|upgrade)
            node_ok || { c_bad "needs Node >= $NODE_MIN"; return 1; }
            # LAW: `skills update` EXITS 0 EVEN FOR A SKILL THAT DOES NOT EXIST.
            # Verified 2026-08-19: `skills update no-such-skill-xyz -g -y` -> 0.
            # So its exit status proves nothing and must not be reported as
            # success. We fingerprint the skill files before and after instead,
            # which distinguishes the three outcomes that actually matter:
            # changed, already current, and disappeared.
            local before after; before="$(pocock_fingerprint)"
            local neutral; neutral="$(mktemp -d 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")"
            local sk
            printf '%s\n' "$POCOCK_SKILLS" | while IFS= read -r sk; do
                [ -n "$sk" ] || continue
                ( cd "$neutral" && npx -y skills update "$sk" -g -y >/dev/null 2>&1 )
            done
            rm -rf "$neutral" 2>/dev/null
            after="$(pocock_fingerprint)"
            local missing; missing="$(pocock_missing)"
            if [ -n "$missing" ]; then
                c_bad "after updating, these are gone: $(printf '%s' "$missing" | tr '\n' ' ')"
                c_warn "reinstall: agent-tools install pocock"
                return 1
            elif [ "$before" = "$after" ]; then
                c_ok "pocock skills already current (no change)"
            else
                c_ok "pocock skills updated (files changed)"
            fi ;;
        uninstall|remove)
            node_ok || { c_bad "needs Node >= $NODE_MIN"; return 1; }
            local neutral; neutral="$(mktemp -d 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")"
            local sk
            printf '%s\n' "$POCOCK_SKILLS" | while IFS= read -r sk; do
                [ -n "$sk" ] || continue
                ( cd "$neutral" && npx -y skills remove "$sk" -g -y >/dev/null 2>&1 )
            done
            rm -rf "$neutral" 2>/dev/null
            c_ok "pocock skills removed — restart your agent for it to take effect" ;;
        *) c_bad "usage: agent-tools pocock [status|install|update|uninstall]"; return 2 ;;
    esac
}

tool_status_line() {   # tool_status_line <name>
    case "$1" in
      rtk)
        if rtk_installed; then
            if rtk_is_right_one; then
                local hf; hf="$(hook_settings_file 2>/dev/null)"
                if hook_present "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" "$RTK_HOOK_CMD"; then
                    c_ok "rtk $(rtk --version 2>/dev/null | awk '{print $2}') — hook active (machine-wide)"
                elif [ -n "$hf" ] && hook_present "$hf" "$RTK_HOOK_CMD"; then
                    c_ok "rtk $(rtk --version 2>/dev/null | awk '{print $2}') — hook active (this repo)"
                else
                    c_warn "rtk installed but NO hook — it filters nothing: agent-tools install rtk"
                fi
            else
                c_bad "rtk on PATH is the crates.io 'Rust Type Kit', not rtk-ai/rtk"
            fi
        else c_warn "rtk not installed"; fi ;;
      superpowers)
        plugin_installed "$SUPERPOWERS_PLUGIN" && c_ok "superpowers installed" \
            || c_warn "superpowers not installed" ;;
      context-mode)
        if plugin_installed "$CONTEXT_MODE_PLUGIN"; then
            c_ok "context-mode installed"
            [ -d "$HOME/.claude/context-mode" ] && c_ok "  state: ~/.claude/context-mode"
        else c_warn "context-mode not installed"; fi ;;
      caveman)
        if caveman_installed; then
            local lvl; lvl="$(caveman_level)"
            c_ok "caveman installed (machine-wide, all agents)${lvl:+ — ACTIVE ($lvl)}"
        else c_warn "caveman not installed"; fi ;;
      pocock)
        if pocock_installed; then
            c_ok "pocock skills installed (machine-wide, all agents)"
            echo "        grill-me, grilling, handoff, wait-what"
        else
            local _miss; _miss="$(pocock_missing)"
            c_warn "pocock skills missing: $(printf '%s' "$_miss" | tr '\n' ' ')"
        fi ;;
      code-review-graph)
        if crg_installed; then
            c_ok "code-review-graph $(uv_tool_version "$CRG_PKG") (opt-in)"
            claude mcp list 2>/dev/null | grep -q "^code-review-graph" \
                && c_ok "  MCP wired in this project" || c_warn "  not wired here (agent-tools wire code-review-graph)"
        else c_warn "code-review-graph not installed (opt-in)"; fi ;;
      token-savior)
        if ts_installed; then
            c_ok "token-savior installed (opt-in)"
            claude mcp list 2>/dev/null | grep -q "^token-savior" \
                && c_ok "  MCP wired in this project" || c_warn "  not wired here (agent-tools wire token-savior)"
        else c_warn "token-savior not installed (opt-in)"; fi ;;
    esac
}

# ---------------------------------------------------------------------------
# INVENTORY: what is here, what is not, and which version of each.
#
# The version sources are deliberately different per tool because there is no
# common one: a uv tool answers --version, a Claude Code plugin only appears in
# `claude plugin list`, and a skill pack has no version at all -- it is
# markdown from a public repo, so the honest answer is a content fingerprint
# and the date it last changed.
# ---------------------------------------------------------------------------

# `claude plugin list` is slow enough that calling it per tool is noticeable.
# Read it once per process.
_PLUGIN_LIST_CACHE=""
plugin_list_cached() {
    have claude || return 1
    [ -n "$_PLUGIN_LIST_CACHE" ] || _PLUGIN_LIST_CACHE="$(claude plugin list 2>/dev/null)"
    printf '%s\n' "$_PLUGIN_LIST_CACHE"
}
plugin_version() {     # plugin_version <name@marketplace>
    plugin_list_cached 2>/dev/null \
        | awk -v want="$1" '
            $0 ~ "❯ " want { found=1; next }
            found && /Version:/ { sub(/^ *Version: */, ""); print; exit }' 2>/dev/null
}

# Skill packs carry no version. The honest substitute is "how many of the
# skills this pack is supposed to install are actually present", plus when they
# last changed.
#
# LAW: count the EXPECTED NAMES, never the directory entries. ~/.agents/skills
# is shared by every pack -- counting entries there reported pocock as "24/4",
# and counting files inside one skill's directory reported caveman as "2/1".
skills_present() {     # skills_present <dir> <newline-delimited names>
    local d="$1" names="$2" n=0 sk
    while IFS= read -r sk; do
        [ -n "$sk" ] || continue
        [ -e "$d/$sk" ] && n=$((n+1))
    done <<EOF
$names
EOF
    printf '%s' "$n"
}
skills_stamp() {       # skills_stamp <dir> <newline-delimited expected names>
    local d="$1" names="$2" n want newest=""
    [ -d "$d" ] || { printf 'not installed'; return 1; }
    n="$(skills_present "$d" "$names")"
    want="$(printf '%s\n' "$names" | grep -c .)"
    newest="$(file_mtime "$d" 2>/dev/null)"
    printf '%s/%s skills%s' "$n" "$want" "${newest:+, updated $newest}"
}

# caveman ships as one directory per skill, all prefixed `caveman`. Enumerate
# what is on disk rather than hardcoding a list that upstream can grow.
caveman_skill_names() {
    local e
    for e in "$HOME"/.agents/skills/caveman*; do
        [ -d "$e" ] && basename "$e"
    done
}

# LAW: NEVER ask a uv-installed tool for its own version. `token-savior
# --version` does not print one -- it boots the recall server, auto-discovers
# every project on the machine and blocks, which turned the inventory into a
# hang. `uv tool list` is one fast call that answers for all three of them.
_UV_LIST_CACHE=""
uv_tool_version() {    # uv_tool_version <uv package name>
    have uv || return 1
    [ -n "$_UV_LIST_CACHE" ] || _UV_LIST_CACHE="$(uv tool list 2>/dev/null)"
    printf '%s\n' "$_UV_LIST_CACHE" \
        | awk -v want="$1" '$1 == want { sub(/^v/, "", $2); print $2; exit }'
}

tool_version() {       # tool_version <feature> -> version string, or nothing
    case "$1" in
      rtk)               have rtk && rtk --version 2>/dev/null | awk '{print $2}' ;;
      graphify)          uv_tool_version graphifyy ;;
      code-review-graph) uv_tool_version "$CRG_PKG" ;;
      token-savior)      uv_tool_version "$TS_PKG" ;;
      superpowers)       plugin_version "$SUPERPOWERS_PLUGIN" ;;
      context-mode)      plugin_version "$CONTEXT_MODE_PLUGIN" ;;
      claude-mem)        plugin_version "claude-mem@thedotmack" ;;
      caveman)           skills_stamp "$HOME/.agents/skills" "$(caveman_skill_names)" ;;
      pocock)            skills_stamp "$(pocock_dir)" "$POCOCK_SKILLS" ;;
    esac
}

# One line per feature: state, name, version, and -- when absent -- the exact
# command that installs it. "Available" with no way to get it is not an
# inventory, it is a tease.
feature_install_hint() {
    case "$1" in
        graphify)   printf 'agent-tools install-machine' ;;
        claude-mem) printf 'agent-tools install-machine' ;;
        *)          printf 'agent-tools install %s' "$1" ;;
    esac
}
feature_kind() {
    case "$1" in
        rtk)                        printf 'hook' ;;
        superpowers|context-mode)   printf 'plugin' ;;
        caveman|pocock)             printf 'skills' ;;
        claude-mem)                 printf 'memory' ;;
        *)                          printf 'MCP' ;;
    esac
}

# ---------------------------------------------------------------------------
# AGENTS — the same tools, without an MCP server in sight.
#
# WHY THIS EXISTS
#   Every graph tool here ships a CLI, and the CLI is the cheaper interface by
#   a wide margin. An MCP server re-sends its whole tool schema EVERY session
#   whether you call it or not -- graphify's is ~1.5k tokens, code-review-graph
#   ships 30 tools. A CLI costs ZERO until the agent runs it, and any agent
#   that can run a shell command can run it.
#
#   That also makes the tools portable. Codex, Antigravity, Cursor, Gemini and
#   the rest do not read Claude Code's MCP config and never will. They can all
#   run `graphify query`.
#
# SO: MCP is the OPTIONAL path, not the default one. `init --no-mcp` wires no
# server at all and instead tells the agent, in its own instruction file, which
# commands to run.
# ---------------------------------------------------------------------------

# Platforms `graphify install --platform` knows. Verified against
# `graphify --help` on 0.9.48 -- do not add a name it will reject.
GRAPHIFY_PLATFORMS="claude codex opencode aider amp agents cursor antigravity gemini kiro pi devin droid trae claw codebuddy hermes windows"

# Where each agent keeps its config, used only to DETECT that it is installed.
# Detection is deliberately read-only: agent-tools never edits another host's
# config file, it reports and instructs.
agent_home() {
    case "$1" in
        claude)      printf '%s' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" ;;
        codex)       printf '%s/.codex' "$HOME" ;;
        antigravity) printf '%s/.antigravity' "$HOME" ;;
        gemini)      printf '%s/.gemini' "$HOME" ;;
        cursor)      printf '%s/.cursor' "$HOME" ;;
        opencode)    printf '%s/.opencode' "$HOME" ;;
        aider)       printf '%s/.aider' "$HOME" ;;
        *)           return 1 ;;
    esac
}
agent_installed() { local d; d="$(agent_home "$1" 2>/dev/null)" && [ -d "$d" ]; }

# Which agents are actually on this machine.
detected_agents() {
    local a
    for a in claude codex antigravity gemini cursor opencode aider; do
        agent_installed "$a" && printf '%s\n' "$a"
    done
}

agents_cmd() {
    hdr "Agents on this machine"
    local found; found="$(detected_agents)"
    if [ -z "$found" ]; then
        c_warn "none detected — looked for claude, codex, antigravity, gemini, cursor, opencode, aider"
    else
        local a
        while IFS= read -r a; do
            [ -n "$a" ] || continue
            printf '  \033[32m✓\033[0m %-12s %s\n' "$a" "$(agent_home "$a")"
        done <<EOF
$found
EOF
    fi

    hdr "How each tool reaches them"
    cat <<'MAP'
  skills      ~/.agents/skills, symlinked into EVERY agent's skills dir.
              caveman and pocock are already there for all of them.
                  agent-tools install caveman | pocock

  CLI         zero standing token cost — nothing is sent until the agent runs
              the command. Works in any agent that can run a shell:
                  graphify query "how does auth work"
                  graphify affected "SomeClass"      graphify god-nodes
                  code-review-graph query|impact|search|architecture
                  ts get|search|ctx|structure        rtk <any command>

  graphify    installs its own skill per platform, no MCP:
   skill          graphify install --platform codex
                  graphify install --platform antigravity

  hooks       rtk and claude-mem hook the host. Claude Code is wired
              automatically; other hosts use their own mechanism, and the CLI
              works regardless.

  MCP         OPTIONAL, and Claude-Code-only here. Costs its schema every
              session whether called or not. Add per repo when you want it:
                  agent-tools wire graphify | code-review-graph | token-savior
                  agent-tools unwire <name>
MAP

    hdr "Give the detected agents the graphify skill"
    if ! have graphify; then
        c_warn "graphify not installed — agent-tools install-machine"
        return 0
    fi
    local a done_any=0
    while IFS= read -r a; do
        [ -n "$a" ] || continue
        case " $GRAPHIFY_PLATFORMS " in
            *" $a "*) ;;
            *) c_warn "$a: graphify has no --platform for it; use the CLI directly"; continue ;;
        esac
        printf '        graphify install --platform %s\n' "$a"
        done_any=1
    done <<EOF
$found
EOF
    [ "$done_any" = 1 ] && c_ok "run those to give each agent the graphify skill (no MCP)"
    return 0
}

inventory_cmd() {
    hdr "agent-tools $VERSION   (released $VERSION_DATE)"

    local f ver installed=() missing=()
    for f in $ALL_FEATURES; do
        if feature_present "$f"; then installed+=("$f"); else missing+=("$f"); fi
    done

    hdr "Installed (${#installed[@]})"
    if [ "${#installed[@]}" = 0 ]; then
        c_warn "nothing yet — agent-tools install-machine"
    else
        for f in "${installed[@]}"; do
            ver="$(tool_version "$f" 2>/dev/null)"
            printf '  \033[32m✓\033[0m %-19s %-8s %s\n' "$f" "$(feature_kind "$f")" "${ver:-version unknown}"
        done
    fi

    hdr "Available (${#missing[@]})"
    if [ "${#missing[@]}" = 0 ]; then
        c_ok "everything agent-tools manages is installed"
    else
        for f in "${missing[@]}"; do
            printf '  \033[33m-\033[0m %-19s %-8s %s\n' "$f" "$(feature_kind "$f")" "$(feature_install_hint "$f")"
        done
    fi

    # Defaults vs opt-in matters more than installed/not for deciding what to
    # add, so say which of the missing ones are deliberate omissions.
    local optin=""
    for f in code-review-graph token-savior; do
        feature_present "$f" || optin="$optin $f"
    done
    [ -n "$optin" ] && { echo; c_ok "not installed by default (they overlap graphify):$optin"; }

    tools_overlap_warnings
    echo
    echo "  detail:    agent-tools tools        per-tool status and wiring"
    echo "  health:    agent-tools doctor       what is broken and how to fix it"
    echo "  remove:    agent-tools uninstall <name|all>"
}

tools_cmd() {
    hdr "Default tools (installed by install-machine)"
    local t
    for t in $DEFAULT_TOOLS; do tool_status_line "$t"; done
    hdr "Opt-in tools (agent-tools install <name>)"
    for t in code-review-graph token-savior; do tool_status_line "$t"; done
    tools_overlap_warnings
    echo
    echo "  install:   agent-tools install <name> [--project]"
    echo "  update:    agent-tools update <name>       (or: update all)"
    echo "  remove:    agent-tools uninstall <name> [--project]"
    echo "  compare:   docs/TOOLS.md — what each one is best at"
    echo
    echo "  --project confines a hook, plugin or MCP entry to this repo."
    echo "  It does NOT apply to caveman or pocock: skills live in"
    echo "  ~/.agents/skills, one copy for every repo and every agent."
}

# Overlaps are the whole reason two of these are opt-in, so say it where
# someone can act on it rather than only in a document.
tools_overlap_warnings() {
    have claude || return 0
    local mcps n=0
    mcps="$(claude mcp list 2>/dev/null | awk '{print $1}')"
    for m in graphify code-review-graph token-savior; do
        printf '%s\n' "$mcps" | grep -q "^$m:\?$" && n=$((n+1))
    done
    if [ "$n" -gt 1 ]; then
        hdr "Overlap in this project"
        c_bad "$n code-graph MCP servers are wired here."
        c_warn "Every one of them re-sends its tool schema EVERY session whether"
        c_warn "or not you call it. Keep the one you actually query:"
        c_warn "    agent-tools unwire code-review-graph | token-savior"
    fi
    if ts_installed && [ "$MEMORY_BACKEND" != none ] \
       && claude mcp list 2>/dev/null | grep -q "^token-savior"; then
        c_warn "token-savior's memory engine and $MEMORY_BACKEND both record sessions"
    fi
    if rtk_installed && plugin_installed "$CONTEXT_MODE_PLUGIN"; then
        c_ok "rtk + context-mode both hook PreToolUse/Bash — they compose (rtk"
        echo "        rewrites the command, context-mode routes the output)"
    fi
    # `ts init` installs token-savior's OWN Bash rewriter hook. That is not a
    # composing layer like context-mode's -- it rewrites the command, which is
    # exactly rtk's job, and two rewriters on one command is a debugging
    # nightmare. `agent-tools wire token-savior` never calls `ts init`; this
    # catches someone who ran it by hand.
    local _gs="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
    if rtk_installed && grep -q 'bash_rewriter_hook' "$_gs" 2>/dev/null \
       && hook_present "$_gs" "$RTK_HOOK_CMD"; then
        c_bad "TWO Bash rewriters are hooked: rtk and token-savior's bash_rewriter_hook."
        c_warn "Keep one. token-savior's came from \`ts init\`; agent-tools wires only"
        c_warn "its MCP server, which does not need that hook."
    fi
}

resolve_tool() {       # normalise the aliases people actually type
    case "$1" in
        rtk) echo rtk ;;
        graphify|graph) echo graphify ;;
        superpowers|superpower) echo superpowers ;;
        context-mode|contextmode|ctx) echo context-mode ;;
        caveman) echo caveman ;;
        pocock|mattpocock|pocock-skills|grill-me|grilling|handoff|wait-what) echo pocock ;;
        code-review-graph|crg) echo code-review-graph ;;
        token-savior|token-saviour|tokensavior|ts) echo token-savior ;;
        *) return 1 ;;
    esac
}

install_tool_cmd() {
    local name="${1:-}"
    [ -n "$name" ] || { c_bad "usage: agent-tools install <$(echo $OPTIONAL_TOOLS | tr ' ' '|')|defaults|all> [--project]"; return 2; }
    if [ "$SCOPE_PROJECT" = 1 ] && [ -z "$(repo_root)" ]; then
        c_bad "--project needs a git repository"; return 1
    fi
    case "$name" in
      defaults) SKIP_RTK=0 SKIP_SUPERPOWERS=0 SKIP_CONTEXT_MODE=0 SKIP_CAVEMAN=0 SKIP_POCOCK=0
                install_extras; return 0 ;;
      all)      SKIP_RTK=0 SKIP_SUPERPOWERS=0 SKIP_CONTEXT_MODE=0 SKIP_CAVEMAN=0 SKIP_POCOCK=0
                install_extras; install_crg; install_ts; return 0 ;;
    esac
    local t; t="$(resolve_tool "$name")" || { c_bad "unknown tool: $name"; return 2; }
    # LAW: skills have NO per-project form. `skills add` writes either
    # ~/.agents/skills (-g) or $PWD/.agents/skills, and the second is not a
    # scope -- it is a stray directory in whatever repo you were standing in,
    # which no agent then reads. Accepting --project here silently installed
    # machine-wide anyway, so the flag lied. Say it and continue globally.
    if [ "$SCOPE_PROJECT" = 1 ]; then
        case "$t" in
            caveman|pocock)
                c_warn "$t is a skill pack — it has no per-project form."
                c_warn "    installing machine-wide (~/.agents/skills) as usual." ;;
        esac
    fi
    case "$t" in
        rtk)               SKIP_RTK=0; install_rtk ;;
        superpowers)       SKIP_SUPERPOWERS=0; install_superpowers ;;
        context-mode)      SKIP_CONTEXT_MODE=0; install_context_mode ;;
        caveman)           SKIP_CAVEMAN=0; install_caveman ;;
        pocock)            SKIP_POCOCK=0; install_pocock ;;
        code-review-graph) install_crg ;;
        token-savior)      install_ts ;;
    esac
}

# ---------------------------------------------------------------------------
# UNINSTALL, and the data question
#
# Removing a tool and destroying what it recorded are two different decisions,
# and 3.3.0 and earlier only ever made the first one -- every uninstall ended
# with a "store kept:" line and left it there. That is a safe default and a
# terrible discovery mechanism: the data sat on disk indefinitely because
# nothing ever offered to remove it.
#
# So: name the data, size it, and ask. Default NO. `--purge` answers yes for
# scripts, `--keep-data` answers no. Anything unregenerable is labelled as
# such, because "rebuild it later" is true for a graph and false for rtk's
# savings history.
# ---------------------------------------------------------------------------

# Newline-delimited "<path>|<what it is>|<regenerable?>" for paths that EXIST.
# Regenerable = "rebuilding costs time, not information".
tool_data_paths() {
    local t="$1" root
    case "$t" in
      rtk)
        local d; d="$(rtk_config_dir)"
        [ -d "$d" ] && printf '%s|filters.toml and history.db — your entire rtk savings record|NO\n' "$d"
        ;;
      context-mode)
        [ -d "$HOME/.claude/context-mode" ] && \
            printf '%s|indexed sessions and the FTS5 knowledge base|NO\n' "$HOME/.claude/context-mode"
        ;;
      token-savior)
        [ -d "$HOME/.local/share/token-savior" ] && \
            printf '%s|the recall store: memory engine plus vector index|NO\n' "$HOME/.local/share/token-savior"
        root="$(repo_root)"
        [ -n "$root" ] && [ -d "$root/.token-savior" ] && \
            printf '%s|this repo'"'"'s index|yes — rebuilt by re-wiring|repo\n' "$root/.token-savior"
        ;;
      code-review-graph)
        root="$(repo_root)"
        [ -n "$root" ] && [ -d "$root/.code-review-graph" ] && \
            printf '%s|this repo'"'"'s parsed graph|yes — rebuilt by re-wiring|repo\n' "$root/.code-review-graph"
        ;;
      graphify)
        [ -d "$HOME/.config/graphify" ] && \
            printf '%s|graphify config, including any API key you set|NO\n' "$HOME/.config/graphify"
        root="$(repo_root)"
        [ -n "$root" ] && [ -d "$root/graphify-out" ] && \
            printf '%s|this repo'"'"'s graph and semantic cache|yes — but a deep re-run costs hours|repo\n' "$root/graphify-out"
        ;;
      claude-mem)
        [ -d "$HOME/.claude-mem" ] && \
            printf '%s|every session claude-mem has ever captured|NO\n' "$HOME/.claude-mem"
        ;;
      # caveman, pocock and superpowers keep nothing of yours: a skill is a
      # markdown file from a public repo, and reinstalling restores it exactly.
      caveman|pocock|superpowers) : ;;
    esac
}

# Human-sized. du on a big store is slow enough to notice, so cap the wait.
path_size() { du -sh "$1" 2>/dev/null | awk '{print $1}'; }

# Show what would be lost. Returns 0 if there IS data, 1 if there is none.
report_tool_data() {
    local t="$1" any=1 path what regen scope
    while IFS='|' read -r path what regen scope; do
        [ -n "${path:-}" ] || continue
        [ "$any" = 1 ] && { echo; c_warn "removing $t would leave this behind:"; any=0; }
        data_line "$path" "$what" "$regen" "$scope"
    done <<EOF
$(tool_data_paths "$t")
EOF
    return "$any"
}

# One row of the data bill. Shared by the per-tool report and `uninstall all`
# so the two cannot describe the same path differently.
data_line() {          # data_line <path> <what> <regen> <scope>
    printf '        %s  (%s)%s\n' "$1" "$(path_size "$1")" \
        "$([ "${4:-}" = repo ] && printf '   [THIS REPO]')"
    printf '            %s\n' "$2"
    case "$3" in
        NO) printf '            \033[31mcannot be regenerated\033[0m\n' ;;
        *)  printf '            %s\n' "$3" ;;
    esac
}

# A DELETE prompt. Deliberately not confirm(): that one defaults to yes, which
# is right for installing and wrong for destroying. Default here is no, and a
# non-interactive run without --purge keeps the data rather than guessing.
confirm_delete() {   # confirm_delete "<what>" -> 0 = delete it
    [ "$KEEP_DATA" = 1 ] && { c_ok "data kept (--keep-data)"; return 1; }
    if [ "$PURGE_DATA" = 1 ]; then c_warn "deleting: $1  (--purge)"; return 0; fi

    local src=""
    if [ -t 0 ]; then src="stdin"
    elif { : < /dev/tty; } 2>/dev/null; then src="tty"; fi
    if [ -z "$src" ]; then
        c_ok "data kept (non-interactive — re-run with --purge to delete)"
        return 1
    fi

    printf '  \033[31m?\033[0m DELETE %s? This cannot be undone. [y/N] ' "$1"
    local reply=""
    if [ "$src" = tty ]; then
        read -r reply < /dev/tty || { echo; c_ok "no answer — data kept"; return 1; }
    else
        read -r reply || { echo; c_ok "no answer — data kept"; return 1; }
    fi
    case "$reply" in
        [yY]|[yY][eE][sS]) return 0 ;;
        *) c_ok "data kept"; return 1 ;;
    esac
}

# Offer to delete a tool's data after the tool itself is gone.
handle_tool_data() {
    local t="$1"
    report_tool_data "$t" || return 0          # nothing to decide
    confirm_delete "the data listed above" || {
        c_warn "restore the tool later and it picks this up again"
        return 0
    }
    local path what regen scope
    while IFS='|' read -r path what regen scope; do
        [ -n "${path:-}" ] || continue
        # Refuse anything that is not under $HOME or the current repo. A bad
        # expansion here deletes something that was never ours.
        case "$path" in
            "$HOME"/*) ;;
            "$(repo_root 2>/dev/null)"/*) ;;
            *) c_bad "refusing to delete outside HOME or this repo: $path"; continue ;;
        esac
        # A repo path is decided by your CWD, not by the tool name, so --purge
        # is not enough consent for it. This is the exact accident that cost
        # this project a graph: a --purge meant for a sandbox, run one
        # directory too high.
        if [ "${scope:-}" = repo ] && [ "$PURGE_DATA" = 1 ] && [ "$PURGE_REPO" != 1 ]; then
            c_warn "kept (repo-scoped): $path"
            c_warn "    --purge covers machine-wide data only."
            c_warn "    add --purge-repo to include THIS repo's data."
            continue
        fi
        rm -rf "$path" 2>/dev/null && c_ok "deleted $path" || c_bad "could not delete $path"
    done <<EOF
$(tool_data_paths "$t")
EOF
}

# Everything `install-machine` puts on a machine, in the order it is safe to
# remove: MCP tools first (they only unwire), then plugins and skills, then the
# things other parts depend on.
ALL_FEATURES="code-review-graph token-savior rtk context-mode superpowers caveman pocock graphify claude-mem"

uninstall_tool_cmd() {
    local name="${1:-}"
    if [ -z "$name" ]; then
        c_bad "usage: agent-tools uninstall <$(echo $OPTIONAL_TOOLS | tr ' ' '|')|graphify|claude-mem|all>"
        c_warn "    add --purge to delete each tool's data without being asked,"
        c_warn "    or --keep-data to keep all of it without being asked."
        return 2
    fi
    [ "$name" = all ] && { uninstall_all; return $?; }

    local t
    case "$name" in
        graphify)   t=graphify ;;
        claude-mem|memory) t=claude-mem ;;
        *) t="$(resolve_tool "$name")" || {
               c_bad "unknown tool: $name"
               c_warn "    known: $OPTIONAL_TOOLS graphify claude-mem all"; return 2; } ;;
    esac
    uninstall_one "$t"
}

# Remove ONE feature, then deal with its data. Split out of the dispatcher so
# `uninstall all` runs the identical path rather than a parallel copy that can
# drift away from it.
uninstall_one() {
    local t="$1"
    hdr "uninstall $t"
    case "$t" in
        rtk)          uninstall_rtk ;;
        superpowers)  uninstall_plugin "$SUPERPOWERS_PLUGIN" superpowers ;;
        context-mode) uninstall_plugin "$CONTEXT_MODE_PLUGIN" context-mode ;;
        caveman)      caveman_cmd uninstall ;;
        pocock)       pocock_cmd uninstall ;;
        code-review-graph)
                      unwire_crg
                      [ "$SCOPE_PROJECT" = 1 ] || { uv tool uninstall "$CRG_PKG" >/dev/null 2>&1 && c_ok "code-review-graph removed"; } ;;
        token-savior)
                      unwire_ts
                      [ "$SCOPE_PROJECT" = 1 ] || { uv tool uninstall "$TS_PKG" >/dev/null 2>&1 && c_ok "token-savior removed"; } ;;
        graphify)
                      if [ "$SCOPE_PROJECT" = 1 ]; then
                          have claude && claude mcp remove graphify -s local >/dev/null 2>&1 \
                              && c_ok "graphify MCP removed from this repo"
                      else
                          have claude && claude mcp remove graphify -s local >/dev/null 2>&1
                          have uv && uv tool uninstall graphifyy >/dev/null 2>&1 \
                              && c_ok "graphify removed" || c_warn "graphify binary not removed (uv missing?)"
                      fi ;;
        claude-mem)
                      # It installs and wires itself, so it uninstalls itself too.
                      if cm_installed; then
                          npx -y claude-mem uninstall >/dev/null 2>&1 \
                              && c_ok "claude-mem uninstalled" \
                              || c_warn "claude-mem uninstall failed — try: npx claude-mem uninstall"
                          # Without a backend, record that fact rather than
                          # letting the default silently reinstate one.
                          remember_backend none
                          c_ok "memory backend set to none"
                      else c_warn "claude-mem not installed"; fi ;;
        *) c_bad "no uninstall path for $t"; return 2 ;;
    esac
    handle_tool_data "$t"
}

# `uninstall all`. Shows the FULL data bill before touching anything, then
# takes one typed confirmation for the removal. Data still gets its own
# per-feature prompt unless --purge/--keep-data already answered.
uninstall_all() {
    hdr "uninstall everything agent-tools installed"

    local present=() f
    for f in $ALL_FEATURES; do
        feature_present "$f" && present+=("$f")
    done
    if [ "${#present[@]}" = 0 ]; then
        c_ok "nothing installed — nothing to remove"; return 0
    fi

    echo "  These will be removed:"
    for f in "${present[@]}"; do printf '        %s\n' "$f"; done

    # The whole bill, before any decision, so nobody discovers a store they
    # cared about three prompts into a teardown.
    local any=1 path what regen scope
    for f in "${present[@]}"; do
        while IFS='|' read -r path what regen scope; do
            [ -n "${path:-}" ] || continue
            [ "$any" = 1 ] && { echo; c_warn "DATA AT RISK:"; any=0; }
            data_line "$path" "$what" "$regen" "$scope"
        done <<EOF
$(tool_data_paths "$f")
EOF
    done
    if [ "$any" = 0 ]; then
        echo
        if [ "$PURGE_DATA" = 1 ]; then
            if [ "$PURGE_REPO" = 1 ]; then
                c_bad "--purge --purge-repo: ALL of the above will be deleted."
            else
                c_bad "--purge is set: machine-wide data above will be deleted."
                c_warn "rows marked [THIS REPO] are KEPT — add --purge-repo for those."
            fi
        elif [ "$KEEP_DATA" = 1 ]; then
            c_ok "--keep-data is set: none of the above will be deleted."
        else
            c_warn "you will be asked about each one separately."
        fi
    fi

    # Typed confirmation. A single keypress is too cheap for this one.
    if [ "$ASSUME_YES" != 1 ]; then
        local src=""
        if [ -t 0 ]; then src="stdin"
        elif { : < /dev/tty; } 2>/dev/null; then src="tty"; fi
        if [ -z "$src" ]; then
            c_bad "non-interactive — re-run with --yes to confirm"; return 1
        fi
        echo
        printf '  \033[31m?\033[0m Type REMOVE to uninstall all of the above: '
        local reply=""
        if [ "$src" = tty ]; then read -r reply < /dev/tty || reply=""
        else read -r reply || reply=""; fi
        [ "$reply" = REMOVE ] || { echo; c_ok "cancelled — nothing was touched"; return 1; }
    fi

    for f in "${present[@]}"; do uninstall_one "$f"; done

    hdr "done"
    c_ok "reinstall any time:  agent-tools install-machine"
    return 0
}

# Is a feature actually on this machine? Used so `uninstall all` lists what is
# really there instead of a menu of things you never had.
feature_present() {
    case "$1" in
        rtk)               rtk_installed ;;
        superpowers)       plugin_installed "$SUPERPOWERS_PLUGIN" ;;
        context-mode)      plugin_installed "$CONTEXT_MODE_PLUGIN" ;;
        caveman)           caveman_installed ;;
        pocock)            pocock_installed ;;
        code-review-graph) crg_installed ;;
        token-savior)      ts_installed ;;
        graphify)          have graphify ;;
        claude-mem)        cm_installed ;;
        *) return 1 ;;
    esac
}

# graphify's MCP is OPTIONAL. `init` adds it by default because Claude Code is
# the common case, but the CLI answers the same questions for zero standing
# tokens, so being able to take the server back out per repo matters.
wire_graphify() {
    have claude || { c_bad "claude CLI not found"; return 1; }
    local r; r="$(repo_root)" || { c_bad "not a git repository"; return 1; }
    have graphify || { c_bad "graphify not installed — agent-tools install-machine"; return 1; }
    if claude mcp list 2>/dev/null | grep -q "^graphify"; then
        c_ok "graphify MCP already wired here"; return 0
    fi
    local gmcp; gmcp="$(command -v graphify-mcp 2>/dev/null)"
    [ -n "$gmcp" ] || { c_bad "graphify-mcp not found — reinstall with the [mcp] extra"; return 1; }
    ( cd "$r" && claude mcp add graphify -s local -- "$gmcp" >/dev/null 2>&1 ) \
        && c_ok "graphify MCP wired (10 tools, ~1.5k tokens every session)" \
        || { c_bad "claude mcp add failed"; return 1; }
}
unwire_graphify() {
    have claude || { c_bad "claude CLI not found"; return 1; }
    claude mcp remove graphify -s local >/dev/null 2>&1 \
        && c_ok "graphify MCP removed from this project" \
        || c_warn "graphify MCP was not wired here"
    c_ok "the CLI still works: graphify query \"...\"  (and costs nothing per session)"
}

wire_tool_cmd() {      # wire/unwire only apply to the project-scoped MCP tools
    local action="$1" name="${2:-}"
    local t; t="$(resolve_tool "$name")" || {
        c_bad "usage: agent-tools $action <graphify|code-review-graph|token-savior>"; return 2; }
    case "$t:$action" in
        code-review-graph:wire)   wire_crg ;;
        code-review-graph:unwire) unwire_crg ;;
        token-savior:wire)        wire_ts ;;
        token-savior:unwire)      unwire_ts ;;
        graphify:wire)            wire_graphify ;;
        graphify:unwire)          unwire_graphify ;;
        *) case "$t" in
             rtk) c_bad "rtk has no per-project MCP entry — it is a hook"
                  c_warn "confine it to this repo: agent-tools install rtk --project" ;;
             caveman|pocock)
                  c_bad "$t has no per-project MCP entry — it is a skill pack"
                  c_warn "skills are always machine-wide: agent-tools install $t" ;;
             *)   c_bad "$t has no per-project MCP entry — it is a plugin"
                  c_warn "confine it to this repo: agent-tools install $t --project" ;;
           esac
           return 2 ;;
    esac
}

# ---------------------------------------------------------------------------
# Updating. Each component updates differently and some have footguns, so a
# single command is safer than asking people to remember four incantations.
#
#   graphify    MUST be reinstalled with extras + the mcp<2 pin re-specified,
#               or you silently lose the gemini backend / the MCP server.
#   claude-mem  its own installer; the worker must be restarted afterwards.

#   caveman     re-run from GitHub (unpinned) + update the global skills.
#   self        git pull + install.sh in the Agent-Tools checkout.
# ---------------------------------------------------------------------------
update_cmd() {
    local what="${1:-}"; what="${what:-all}"
    # Aliases first, so `update crg` and `update ts` behave like everywhere else.
    case "$what" in
        all|tools|graphify|memory|self) ;;
        *) local _t; if _t="$(resolve_tool "$what")"; then what="$_t"
           else c_bad "usage: agent-tools update [all|tools|graphify|memory|self|$(echo $OPTIONAL_TOOLS | tr ' ' '|')]"
                return 2; fi ;;
    esac
    # `all` never INSTALLS something you do not have — an update command that
    # quietly adds tools is not an update command. Each branch below checks.

    if [ "$what" = all ] || [ "$what" = graphify ]; then
        hdr "graphify"
        if have uv; then
            c_warn "an upgrade can invalidate the semantic cache (re-extraction costs hours)"
            uv tool install "graphifyy[gemini,mcp]" --with "mcp<2" --force >/dev/null 2>&1 \
                && c_ok "graphify $(graphify --version 2>/dev/null | awk '{print $2}')" \
                || c_bad "graphify update failed"
        else c_warn "uv not installed — skipping"; fi
    fi

    if [ "$what" = all ] || [ "$what" = memory ]; then
        hdr "memory backend ($MEMORY_BACKEND)"
        case "$MEMORY_BACKEND" in
          claude-mem)
            if node_ok; then
                npx -y claude-mem@latest install >/dev/null 2>&1 \
                    && c_ok "claude-mem updated" || c_bad "claude-mem update failed"
                npx claude-mem start >/dev/null 2>&1 \
                    && c_ok "worker restarted" \
                    || c_warn "start the worker yourself: npx claude-mem start"
            else c_warn "needs Node >= $NODE_MIN — skipping"; fi ;;
          none) c_warn "no memory backend selected" ;;
        esac
    fi

    if [ "$what" = all ] || [ "$what" = tools ] || [ "$what" = caveman ]; then
        caveman_installed && { hdr "caveman"; caveman_cmd update; } \
            || { [ "$what" = caveman ] && c_warn "caveman not installed — agent-tools install caveman"; }
    fi

    if [ "$what" = all ] || [ "$what" = tools ] || [ "$what" = pocock ]; then
        if pocock_installed; then hdr "pocock"; pocock_cmd update
        elif [ "$what" = pocock ]; then c_warn "pocock skills not installed — agent-tools install pocock"; fi
    fi

    if [ "$what" = all ] || [ "$what" = tools ] || [ "$what" = rtk ]; then
        if rtk_installed; then hdr "rtk"; update_rtk
        elif [ "$what" = rtk ]; then c_warn "rtk not installed — agent-tools install rtk"; fi
    fi

    if [ "$what" = all ] || [ "$what" = tools ] || [ "$what" = superpowers ]; then
        if plugin_installed "$SUPERPOWERS_PLUGIN"; then hdr "superpowers"; update_plugin "$SUPERPOWERS_PLUGIN" superpowers
        elif [ "$what" = superpowers ]; then c_warn "superpowers not installed — agent-tools install superpowers"; fi
    fi

    if [ "$what" = all ] || [ "$what" = tools ] || [ "$what" = context-mode ]; then
        if plugin_installed "$CONTEXT_MODE_PLUGIN"; then hdr "context-mode"; update_plugin "$CONTEXT_MODE_PLUGIN" context-mode
        elif [ "$what" = context-mode ]; then c_warn "context-mode not installed — agent-tools install context-mode"; fi
    fi

    if [ "$what" = all ] || [ "$what" = tools ] || [ "$what" = code-review-graph ]; then
        if crg_installed; then
            hdr "code-review-graph"
            uv tool upgrade "$CRG_PKG" >/dev/null 2>&1 \
                && c_ok "code-review-graph $(uv_tool_version "$CRG_PKG")" \
                || c_warn "update failed"
            # Its graph is keyed to the parser version, so a version bump can
            # leave a graph the new binary disagrees with. Cheap to redo: no LLM.
            [ -d "$(repo_root)/.code-review-graph" ] 2>/dev/null \
                && c_warn "re-run 'code-review-graph build' in wired repos after a version bump"
        elif [ "$what" = code-review-graph ]; then c_warn "not installed — agent-tools install code-review-graph"; fi
    fi

    if [ "$what" = all ] || [ "$what" = tools ] || [ "$what" = token-savior ]; then
        if ts_installed; then
            hdr "token-savior"
            # upgrade drops extras that were declared at install time, so
            # reinstall with them named or vector recall silently disappears.
            uv tool install "$TS_EXTRAS" --force >/dev/null 2>&1 \
                && c_ok "token-savior updated (extras re-specified)" || c_warn "update failed"
        elif [ "$what" = token-savior ]; then c_warn "not installed — agent-tools install token-savior"; fi
    fi

    if [ "$what" = all ] || [ "$what" = self ]; then
        hdr "agent-tools itself"
        local src; src="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
        # Running from ~/.local/bin is the NORMAL case, not the exception.
        if [ ! -d "$src/.git" ]; then
            local rec; rec="$(recorded_source 2>/dev/null)"
            [ -n "$rec" ] && [ -d "$rec/.git" ] && src="$rec"
        fi
        if [ -d "$src/.git" ]; then
            # A checkout with no remote (someone unzipped an archive and ran
            # git init) cannot pull. Point it at the public repo once.
            if ! git -C "$src" remote get-url origin >/dev/null 2>&1; then
                c_warn "$src has no 'origin' remote — add one to pull updates:"
                echo "        git -C \"$src\" remote add origin $REPO_URL"
            elif ( cd "$src" && git pull --ff-only >/dev/null 2>&1 ); then
                ( cd "$src" && ./install.sh >/dev/null 2>&1 ) \
                    && c_ok "updated from $REPO_URL -> $src" \
                    || c_warn "pulled, but install.sh failed — run it yourself in $src"
            else
                c_warn "could not fast-forward $src (local commits, or a dirty tree)"
                echo "        cd \"$src\" && git status    # then pull and ./install.sh"
            fi
        else
            # No checkout at all: fetch one. This is the path for anyone who
            # installed from a downloaded archive rather than a clone.
            c_warn "no git checkout recorded — this copy came from an archive"
            if ! have git; then
                c_bad "git is not installed; download the latest manually:"
                echo "        $REPO_URL"
                return 1
            fi
            local dest="$HOME/.local/share/agent-tools-src"
            if confirm "a clone of $REPO_URL into $dest (then install from it)"; then
                rm -rf "$dest" 2>/dev/null
                if git clone --depth 1 "$REPO_URL" "$dest" >/dev/null 2>&1 \
                   && ( cd "$dest" && ./install.sh >/dev/null 2>&1 ); then
                    c_ok "cloned and installed from $REPO_URL"
                    c_ok "future updates: agent-tools update self"
                else
                    c_bad "clone or install failed — do it by hand:"
                    echo "        git clone $REPO_URL && cd AgentTools && ./install.sh"
                fi
            else
                echo "        git clone $REPO_URL && cd AgentTools && ./install.sh"
            fi
        fi
    fi

    echo
    c_ok "done — run 'agent-tools doctor' to confirm nothing came loose"
}

# ---------------------------------------------------------------------------
# migrate — move everything git cannot carry to another computer.
#
# WHY A COMMAND AND NOT A DOCUMENTED tar LINE
#   The path list is not stable across machines or backends, and two details are
#   easy to get wrong by hand:
#     * the memory worker must be STOPPED at both ends, or you copy a
#       half-written SQLite store;
#     * ~/.claude/CLAUDE.md can `@`-import other files (RTK.md, etc.). Copying
#       CLAUDE.md without them silently breaks the import, and nothing warns you.
#   This resolves both, skips ~800 MB of reinstallable caches, and refuses to
#   clobber an existing store unless told to.
#
# PLATFORMS
#   Paths are identical relative to $HOME on macOS, Linux and WSL2. On native
#   Windows run it from Git Bash (tar ships with Windows 10+). WSL2 is its OWN
#   machine: archive inside the distro, not from the Windows profile.
# ---------------------------------------------------------------------------
migrate_paths() {                      # prints HOME-relative paths that exist
    local p
    for p in .claude-mem .agentmemory .claude.json \
             .config/graphify .config/agent-tools \
             .claude/CLAUDE.md .claude/settings.json .claude/plans \
             .claude/projects .claude/.caveman-active \
             .claude/context-mode \
             .local/share/token-savior \
             .code-review-graph \
             "$RTK_CONF_REL"; do
        [ -n "$p" ] || continue
        [ -e "$HOME/$p" ] && printf '%s\n' "$p"
    done
    # Files pulled in by `@import` lines at the top of the global CLAUDE.md.
    # Missing these is the quiet failure this command exists to prevent.
    if [ -f "$HOME/.claude/CLAUDE.md" ]; then
        sed -n 's/^@\([A-Za-z0-9_./-]*\).*/\1/p' "$HOME/.claude/CLAUDE.md" 2>/dev/null \
        | while read -r imp; do
            [ -n "$imp" ] || continue
            [ -e "$HOME/.claude/$imp" ] && printf '.claude/%s\n' "$imp"
          done
    fi
}

migrate_stop_memory() {
    [ "$MEMORY_BACKEND" = claude-mem ] && have npx && npx claude-mem stop >/dev/null 2>&1
    # A legacy agentmemory store is still archived by migrate_paths, and its
    # engine overwrites the session index mid-copy if it is left running. We do
    # not manage that server any more, but we will not corrupt its data either.
    if am_legacy_active; then
        c_warn "a legacy agentmemory is running — stopping it so its store copies cleanly"
        am_legacy_stop_service
    fi
    return 0
}

migrate_start_memory() {
    [ "$MEMORY_BACKEND" = claude-mem ] && have npx && npx claude-mem start >/dev/null 2>&1
    return 0
}

migrate_cmd() {
    local action="${1:-}" file="${2:-}"
    case "$action" in
      export)
        file="${file:-$HOME/agent-move.tgz}"
        hdr "Exporting what git cannot carry"
        have tar || { c_bad "tar not found (on Windows use Git Bash)"; return 1; }

        local list; list="$(migrate_paths)"
        [ -n "$list" ] || { c_bad "nothing found to export"; return 1; }

        c_warn "stopping the memory worker so its store is not mid-write"
        migrate_stop_memory

        # A manifest makes a restore self-describing months later. Stage it
        # INSIDE $HOME and archive everything from one directory: mixing -C with
        # a path list is not portable -- bsdtar resolved a -T list against the
        # new cwd and archived /var instead. One cwd, no -C, no surprises.
        local man=".agent-tools-manifest.txt"
        {
            printf 'created: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
            printf 'platform: %s\n' "$PLATFORM"
            printf 'memory_backend: %s\n' "$MEMORY_BACKEND"
            printf 'paths:\n'
            printf '%s\n' "$list" | sed 's/^/  - /'
        } > "$HOME/$man"

        printf '%s\n' "$list" | sed 's/^/  + /'
        # A -T list file, not an argument list: rtk's macOS config lives in
        # "Library/Application Support/rtk" and an unquoted $list word-splits
        # that into three nonexistent paths. One name per line has no such
        # failure mode. We stay in $HOME and never pass -C, so the names
        # resolve against the directory we intend (mixing -C with -T resolved
        # against the WRONG cwd on bsdtar -- that is why there is no -C here).
        local flist=".agent-tools-filelist.txt"
        { printf '%s\n' "$man"; printf '%s\n' "$list"; } > "$HOME/$flist"
        # Excludes: machine- and architecture-specific things that must NOT
        # travel. ~/.agentmemory/bin/iii is a 27 MB native binary (arm64 Mach-O
        # here) that is the WRONG ARCHITECTURE anywhere else -- it re-downloads.
        # PIDs and engine state can make a later `stop --force` signal an
        # unrelated process. Logs and .DS_Store are noise.
        ( cd "$HOME" && tar czf "$file" \
            --exclude '.agentmemory/bin' \
            --exclude '.agentmemory/logs' \
            --exclude '*.pid' \
            --exclude 'engine-state.json' \
            --exclude '.DS_Store' \
            -T "$flist" ) 2>/dev/null \
            || { c_bad "tar failed"; rm -f "$HOME/$man" "$HOME/$flist"; migrate_start_memory; return 1; }
        rm -f "$HOME/$man" "$HOME/$flist"

        migrate_start_memory
        c_ok "wrote $file ($(du -h "$file" 2>/dev/null | cut -f1))"
        echo
        c_warn "NOT included (reinstall instead): plugin and uv-tool BINARIES,"
        # Prose for a human, not a path this script resolves.
        # shellcheck disable=SC2088
        c_warn "~/.local/bin, ~/.agents/skills, shell-snapshots, session-env, caches."
        c_warn "Their DATA is included: context-mode sessions, token-savior's store,"
        c_warn "rtk's savings history, and every @import your global CLAUDE.md pulls in."
        echo
        c_warn "On the new machine:"
        c_warn "    agent-tools migrate import $(basename "$file")"
        c_warn "    agent-tools install-machine     # reinstalls the binaries + plugins"
        ;;

      import)
        [ -n "$file" ] || { c_bad "usage: agent-tools migrate import <archive.tgz>"; return 2; }
        [ -f "$file" ] || { c_bad "no such file: $file"; return 1; }
        hdr "Restoring from $file"
        have tar || { c_bad "tar not found (on Windows use Git Bash)"; return 1; }

        tar tzf "$file" >/dev/null 2>&1 || { c_bad "not a readable tar.gz"; return 1; }
        tar xzOf "$file" .agent-tools-manifest.txt 2>/dev/null | sed 's/^/  /' || true

        c_warn "stopping the memory worker before overwriting its store"
        migrate_stop_memory

        # -k keeps existing files: a fresh install may already have created a
        # store, and silently replacing it is not a decision to make for someone.
        local flags="xzkf"
        [ "$FORCE_IMPORT" = 1 ] && flags="xzf"
        tar "$flags" "$file" -C "$HOME" 2>/dev/null
        rm -f "$HOME/.agent-tools-manifest.txt"
        local rc=$?
        [ "$FORCE_IMPORT" = 1 ] || c_warn "existing files were KEPT (--force to overwrite)"

        migrate_start_memory
        [ "$rc" = 0 ] && c_ok "restore complete" || c_warn "tar reported conflicts; see the note above"
        echo
        c_ok "next:  agent-tools install-machine          # binaries + plugins back"
        c_ok "then:  cd <project> && agent-tools init && agent-tools refresh --code-only"
        c_ok "then:  agent-tools doctor    and    agent-tools tools"
        ;;

      *) c_bad "usage: agent-tools migrate export [FILE] | import <FILE> [--force]"; return 2 ;;
    esac
}

install_machine() {
    hdr "Platform: $PLATFORM"
    [ "$PLATFORM" = windows ] && c_warn "native Windows: everything but rtk installs here (rtk needs Rust or the release zip)."
    if [ "$PLATFORM" = macos ] && ! have brew; then c_bad "install Homebrew first: https://brew.sh"; exit 1; fi

    hdr "1. Prerequisites"
    if node_ok; then c_ok "node $(node -v)"
    elif have_native node; then
        c_bad "node $(node -v) is too old — need >= $NODE_MIN"
        if confirm "a modern Node from NodeSource (adds their apt repo)"; then
            install_node_modern && c_ok "node $(node -v)" || c_warn "NodeSource failed — use nvm or fnm"
        fi
    elif confirm "Node.js (required for claude-mem and the npm tools; graphify works without it)"; then
        install_node && c_ok "node $(node -v)" || c_warn "node install did not succeed"
    fi
    if have uv; then c_ok "uv $(uv --version 2>/dev/null | awk '{print $2}')"
    elif confirm "uv (REQUIRED for graphify)"; then
        install_uv && c_ok "uv $(uv --version 2>/dev/null | awk '{print $2}')"
    fi
    have uv || { c_bad "uv is required for graphify — nothing further to do"; exit 1; }

    # agent-tools itself needs a working python (reading the graph, writing
    # .claude/settings.json). graphify does not — uv gives it its own. On
    # Windows a system python is often absent, or is the Microsoft Store stub.
    if [ -z "$PY" ]; then
        c_bad "no working python found (on Windows, python3 is often a Store stub)"
        if confirm "a Python via uv (no admin rights, no extra package manager)"; then
            uv python install >/dev/null 2>&1
            PY="$(_pick_python)"
            [ -n "$PY" ] && c_ok "python ready: $PY" || c_warn "could not provision python — install Python 3 yourself"
        fi
    else
        c_ok "python: $PY"
    fi

    hdr "2. graphify (extras + the mcp<2 pin)"
    if have graphify && [ "$ASSUME_YES" = 0 ] && [ "$NO_INSTALL" = 1 ]; then
        c_ok "graphify $(graphify --version 2>/dev/null | awk '{print $2}') (left as-is)"
    elif have graphify || confirm "graphify"; then
        uv tool install "graphifyy[gemini,mcp]" --with "mcp<2" --force >/dev/null 2>&1 \
            && c_ok "graphify installed" || c_bad "graphify install failed"
    fi

    if [ "$MEMORY_BACKEND" = none ]; then
        hdr "3. memory — SKIPPED (--memory=none)"
        c_ok "graphify is set up; no memory backend requested"
        # --memory=none used to return here and skip the optional tools too,
        # so "no memory backend" silently meant "no rtk, no skills either".
        install_extras
        hdr "Next"
        echo "  cd <your-project> && agent-tools init"
        return
    fi

    if [ "$MEMORY_BACKEND" = claude-mem ]; then
        hdr "3. memory backend: claude-mem"
        # Loud warning rather than a block: the user may deliberately keep the
        # other installed but inactive. Two ACTIVE capturers is the problem.
        if am_legacy_active; then
            c_bad "a LEGACY agentmemory is still capturing. Do not run both at once:"
            c_bad "  every tool call would fire two hook sets into two stores."
            c_warn "Retire it first (keeps the data, moves it into claude-mem):"
            c_warn "    agent-tools memory migrate-from-agentmemory"
        fi
        if cm_installed; then c_ok "claude-mem present"
        elif ! have npm; then c_warn "npm missing — cannot install claude-mem"
        elif confirm "claude-mem (memory that persists across sessions)"; then
            npx -y claude-mem install >/dev/null 2>&1 \
              && c_ok "claude-mem installed (it wires its own hooks + MCP)" \
              || c_bad "claude-mem install failed — try: npx claude-mem install"
        fi
        remember_backend claude-mem
        install_extras
        hdr "Next"
        echo "  cd <your-project> && agent-tools init"
        echo "  claude-mem has NO bulk importer; to replay past sessions see"
        echo "  scripts/claude-mem-import-transcripts.sh (unverified — dry-run first)"
        return
    fi

    # No other backend exists. `--memory=none` falls through to here so the
    # optional tools still get installed; a machine with no memory backend is a
    # supported choice, not an error.
    hdr "3. memory backend: none"
    c_warn "no session capture (--memory=none). Switch on later with:"
    c_warn "    agent-tools memory switch claude-mem"
    remember_backend none
    install_extras
    hdr "Next"
    echo "  cd <your-project> && agent-tools init"
}

# ---------------------------------------------------------------------------
init_project() {
    local root; root="$(git rev-parse --show-toplevel 2>/dev/null)" || { c_bad "not a git repository"; exit 1; }
    cd "$root" || exit 1
    hdr "Project: $root  (platform: $PLATFORM)"

    if ! grep -q "graphify-out/\*" .gitignore 2>/dev/null; then
        cat >> .gitignore <<'GI'

# Graphify knowledge graph. Derived output is ignored; the LLM-derived cache and
# labels ARE committed — that is the expensive part (hours of extraction in a
# couple of MB), and it lets a fresh clone rebuild the graph at zero LLM cost.
# SYNTAX: never use `graphify-out/` or `graphify-out/**` — git will not descend
# into an excluded directory, which silently kills every negation below.
graphify-out/*
!graphify-out/cache/
graphify-out/cache/*
!graphify-out/cache/semantic-deep/
!graphify-out/.graphify_labels.json
!graphify-out/.graphify_labels.json.sig
GI
        c_ok ".gitignore rules added"
    else c_ok ".gitignore already configured"; fi

    mkdir -p .claude
    if ! grep -q "graphify hook-guard" .claude/settings.json 2>/dev/null; then
        "$PY" - <<'PY'
import json, os
p = ".claude/settings.json"
d = {}
if os.path.exists(p):
    try: d = json.load(open(p))
    except Exception: d = {}
hooks = d.setdefault("hooks", {}).setdefault("PreToolUse", [])
have = json.dumps(hooks)
# Bare `graphify` on PATH — an absolute path breaks on the next machine.
for matcher, kind in (("Bash", "search"), ("Read|Glob", "read")):
    if f"hook-guard {kind}" not in have:
        hooks.append({"matcher": matcher,
                      "hooks": [{"type": "command", "command": f"graphify hook-guard {kind}"}]})
json.dump(d, open(p, "w"), indent=2)
PY
        c_ok "hook-guard added to .claude/settings.json"
    else c_ok "hook-guard already present"; fi

    if [ ! -f .git/hooks/post-commit ] || ! grep -q graphify .git/hooks/post-commit 2>/dev/null; then
        cat > .git/hooks/post-commit <<'HK'
#!/bin/bash
# graphify auto-update — code only (AST, no LLM, no cost), never blocks a commit.
# OPT-IN by design: absent gate file == disabled. An opt-out guard once vanished
# and silently re-enabled itself, re-clustering the graph after a commit.
REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
ENABLE="$REPO/.git/graphify-auto-update-ENABLED"; LOG="$REPO/.git/graphify-auto-update.log"
[ -f "$ENABLE" ] || exit 0
# Skip mid-rebase/merge/cherry-pick: a 20-commit rebase would otherwise fire 20
# rebuilds, and an unstaged graphify-out/ blocks `git rebase --continue`.
GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] || [ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0
# Concurrency guard. Deliberately GLOBAL, not repo-scoped: reading another
# process's cwd needs /proc (Linux) or lsof (macOS) and is not portable. A run
# in another repo therefore suppresses this one -- conservative, but it must not
# be SILENT, or the graph quietly stops updating and nobody knows why.
if command -v pgrep >/dev/null 2>&1; then
  if pgrep -f "graphif[y] (extract|update|label|cluster-only|watch)" >/dev/null 2>&1; then
    echo "[$(date '+%F %T')] skipped: another graphify run is in flight" >> "$LOG"
    exit 0
  fi
fi
GRAPHIFY="$(command -v graphify || echo "$HOME/.local/bin/graphify")"
[ -x "$GRAPHIFY" ] || exit 0
( cd "$REPO" && echo "[$(date '+%F %T')] update $(git rev-parse --short HEAD)" >> "$LOG" \
  && "$GRAPHIFY" update . >> "$LOG" 2>&1 ) >/dev/null 2>&1 &
exit 0
HK
        chmod +x .git/hooks/post-commit
        c_ok "post-commit hook installed (DISABLED by default)"
    else c_ok "post-commit hook already present"; fi

    # Branch switches change code wholesale, so a graph built on the old branch
    # is stale until the next commit. graphify ships its own post-checkout hook,
    # but `graphify hook install` also writes `.gitattributes` -- a COMMITTED
    # file -- registering a merge driver that only exists in the local
    # .git/config, by absolute path. Teammates would inherit a merge=graphify
    # attribute pointing at a driver they do not have. So we install the useful
    # half ourselves, behind the same opt-in gate.
    if [ ! -f .git/hooks/post-checkout ] || ! grep -q graphify .git/hooks/post-checkout 2>/dev/null; then
        cat > .git/hooks/post-checkout <<'HK'
#!/bin/bash
# graphify auto-update on branch switch — code only (AST, no LLM, no cost).
# OPT-IN: absent gate file == disabled. Same gate as post-commit.
[ "$3" = "1" ] || exit 0                      # $3=1 means branch switch, not file checkout
REPO="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
ENABLE="$REPO/.git/graphify-auto-update-ENABLED"; LOG="$REPO/.git/graphify-auto-update.log"
[ -f "$ENABLE" ] || exit 0
[ -d "$REPO/graphify-out" ] || exit 0         # never build a graph from scratch here
GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ] && exit 0
# Concurrency guard. Deliberately GLOBAL, not repo-scoped: reading another
# process's cwd needs /proc (Linux) or lsof (macOS) and is not portable. A run
# in another repo therefore suppresses this one -- conservative, but it must not
# be SILENT, or the graph quietly stops updating and nobody knows why.
if command -v pgrep >/dev/null 2>&1; then
  if pgrep -f "graphif[y] (extract|update|label|cluster-only|watch)" >/dev/null 2>&1; then
    echo "[$(date '+%F %T')] skipped: another graphify run is in flight" >> "$LOG"
    exit 0
  fi
fi
GRAPHIFY="$(command -v graphify || echo "$HOME/.local/bin/graphify")"
[ -x "$GRAPHIFY" ] || exit 0
( cd "$REPO" && echo "[$(date '+%F %T')] checkout $(git rev-parse --abbrev-ref HEAD)" >> "$LOG" \
  && "$GRAPHIFY" update . >> "$LOG" 2>&1 ) >/dev/null 2>&1 &
exit 0
HK
        chmod +x .git/hooks/post-checkout
        c_ok "post-checkout hook installed (DISABLED by default)"
    else c_ok "post-checkout hook already present"; fi

    if [ "$ADD_MCP" != 1 ]; then
        # DEFAULT since 3.4.0: no server. Nothing is re-sent every session; the
        # instruction block below tells the agent which commands to run
        # instead. This is also the mode that works identically in Codex,
        # Antigravity and every other host, none of which read Claude Code's
        # MCP config.
        #
        # LAW: an already-wired repo is LEFT ALONE. `init` is idempotent and
        # re-run routinely to pick up new hooks; having it silently tear out a
        # server someone deliberately added would make a maintenance command
        # destructive.
        if have claude && claude mcp list 2>/dev/null | grep -q "^graphify"; then
            c_ok "graphify MCP already wired here — left as-is"
            echo "        remove it with:  agent-tools unwire graphify"
        else
            c_ok "no MCP server wired (default — 0 standing tokens)"
            echo "        the agent uses the CLI:  graphify query \"...\""
            echo "        want the server here?    agent-tools init --add-mcp"
        fi
    elif have claude; then
        local gmcp; gmcp="$(command -v graphify-mcp || echo "$BIN/graphify-mcp")"
        claude mcp list 2>/dev/null | grep -q "^graphify" \
            && c_ok "graphify MCP already wired" \
            || { claude mcp add graphify -s local -- "$gmcp" >/dev/null 2>&1 && c_ok "graphify MCP wired (10 tools, ~1.5k tokens)"; }
        # claude-mem registers its own MCP during `claude-mem install`, so we
        # must not add a second entry.
        if [ "$MEMORY_BACKEND" = claude-mem ]; then
            c_ok "claude-mem wires its own MCP (nothing to add here)"
            # A leftover entry from the agentmemory era would keep a dead
            # server in every session's tool list, costing schema tokens for
            # tools that can never answer.
            if claude mcp list 2>/dev/null | grep -q "^agentmemory"; then
                c_warn "a stale agentmemory MCP entry is wired to a server nothing starts"
                c_warn "    claude mcp remove agentmemory -s local"
            fi
        fi
    fi

    # The backend choice is machine-wide (~/.config/agent-tools/config), not
    # per-project. It is written by install-machine and by `memory switch` --
    # but a machine set up by hand never ran either, so the file can be absent
    # and the backend silently inherited from MEMORY_DEFAULT. That works until
    # the default changes under you. Record the effective value once.
    if [ ! -f "$AT_CONFIG" ]; then
        remember_backend "$MEMORY_BACKEND"
        c_ok "recorded memory backend '$MEMORY_BACKEND' in $AT_CONFIG"
    fi

    # --- agent instructions -------------------------------------------------
    # MCP tools alone are passive: an agent CAN call them but often won't. The
    # durable fix is the instruction file the agent already reads every session.
    # CLAUDE.md FIRST when it exists: it is what Claude Code actually reads, and
    # it is the file that bloats — putting a "keep this lean" rule in a
    # different file than the one growing is theatre. AGENTS.md is the
    # cross-agent standard, so it is the fallback and what we create fresh.
    local instr=""
    for f in CLAUDE.md AGENTS.md .cursorrules; do [ -f "$f" ] && { instr="$f"; break; }; done
    [ -z "$instr" ] && instr="AGENTS.md"
    # `graphify claude install` writes its own "## graphify" section covering the
    # same ground. We do not call it (our block is a superset and stays portable),
    # but a user who ran it by hand ends up with both -- duplicate instructions in
    # the one file we ask to keep lean. Say so rather than quietly stacking.
    if grep -q "^## graphify$" "$instr" 2>/dev/null; then
        c_warn "$instr already has graphify's own section; ours repeats it"
        c_warn "    graphify claude uninstall   # then re-run: agent-tools init"
    fi
    if grep -q "agent-tools:managed" "$instr" 2>/dev/null; then
        c_ok "agent instructions already in $instr"
    elif confirm "a short 'use the graph and memory' section in $instr"; then
        cat >> "$instr" <<'INSTR'

<!-- agent-tools:managed -->
## Codebase knowledge (graphify)

Before grepping or reading files broadly, ask the graph:

    graphify query "<question>"        # scoped subgraph, cheap
    graphify affected "<symbol>"       # blast radius before refactoring
    graphify god-nodes                 # what is risky to touch at all
    graphify path "<A>" "<B>"          # how two things connect
    graphify explain "<concept>"       # one concept, focused

If graphify-out/wiki/index.md exists, use it to navigate broadly. Read
GRAPH_REPORT.md only for whole-architecture review — it is large.

The graph covers code structure, docs and concepts. It does NOT index
string-level details (CSS variables, literals) — use grep for those.
If the graph looks stale, run `agent-tools refresh`.

## Memory

Past sessions are searchable through the memory backend. Recall before
re-deriving an earlier decision, and save durable decisions explicitly.
Memory is for decisions and rationale; the graph is for what the code *is*.

## Keep this file lean

This file is read into context on EVERY session, so its size is a permanent
tax on every request. Keep it to things that do not fit anywhere else:

- build / test / lint / run commands
- hard constraints and invariants that must never be violated
- pointers to where the real documentation lives

Do NOT put here: session logs, changelogs, status updates, narrative history,
lists of what was done and when, or anything that reads like a diary. Those
belong in the memory backend (decisions, rationale) or in docs/ (long-form).
If a section is growing over time rather than being edited, it belongs
somewhere else.
<!-- /agent-tools:managed -->
INSTR
        c_ok "agent instructions added to $instr"
    fi

    if [ -f graphify-out/graph.json ]; then
        c_ok "graph exists: $(graph_stats)"
    else
        hdr "Building the code graph (AST only, no LLM, no cost)"
        graphify update . 2>&1 | tail -3
        c_ok "graph built: $(graph_stats)"
        echo
        c_warn "Docs are NOT indexed yet — that pass uses an LLM. When you want it:"
        echo "      agent-tools refresh"
    fi

    hdr "Done"
    echo "  agent-tools doctor    verify"
    echo "  agent-tools refresh   after a batch of work"
    echo "  agent-tools tools     optional tools, and what overlaps here"
    echo "  touch .git/graphify-auto-update-ENABLED   to auto-update on commit"
    echo
    echo "  Want a second code graph in THIS repo only? (see docs/TOOLS.md first)"
    echo "      agent-tools install code-review-graph && agent-tools wire code-review-graph"
}

# ---------------------------------------------------------------------------
# Run a refresh in the background, surviving the terminal that launched it.
# Mechanism per platform, best available first:
#   Linux/WSL + systemd : systemd-run --user transient unit. Cleans itself up
#                         when the command exits — nothing to unregister.
#   macOS               : caffeinate (so idle sleep cannot pause a long run)
#                         wrapped in nohup, detached from the shell.
#   anything else       : plain nohup.
# The detached child is invoked WITHOUT --detach, or it would detach forever.
detach_refresh() {
    local mode="$1" root="$2"
    local log="$root/.git/graphify-refresh.log"
    [ -d "$root/.git" ] || log="$root/graphify-refresh.log"
    local self; self="$(command -v agent-tools || echo "$0")"

    if graphify_busy_here "$root"; then
        c_bad "a graphify run is already active in this repo: ${BUSY_WHERE:-?}"; return 1
    fi

    hdr "Detaching"
    echo "  mode : ${mode/#full/full (code + docs + naming)}"
    echo "  log  : $log"
    : > "$log"

    case "$PLATFORM" in
      linux|wsl)
        if has_systemd; then
            local unit="graphify-refresh-$$"
            systemd-run --user --unit="$unit" --working-directory="$root" \
                --setenv=PATH="$PATH" \
                bash -c "'$self' refresh $mode >> '$log' 2>&1" >/dev/null 2>&1 \
              && { c_ok "started as systemd transient unit: $unit"
                   _detach_help "journalctl --user -u $unit -f" "systemctl --user stop $unit" "$log"
                   return 0; }
            c_warn "systemd-run failed — falling back to nohup"
        fi ;;
      macos)
        # caffeinate -i keeps the machine awake for the CHILD's lifetime only.
        ( cd "$root" && nohup caffeinate -i -m "$self" refresh $mode >> "$log" 2>&1 & ) >/dev/null 2>&1
        c_ok "started detached (caffeinate keeps the machine awake for it)"
        _detach_help "tail -f '$log'" "agent-tools stop" "$log"
        return 0 ;;
    esac

    ( cd "$root" && nohup "$self" refresh $mode >> "$log" 2>&1 & ) >/dev/null 2>&1
    c_ok "started detached (nohup)"
    _detach_help "tail -f '$log'" "agent-tools stop" "$log"
    return 0
}

# Printed after every successful detach, so the three questions people actually
# have — is it alive, how do I watch it, how do I stop it — are answered without
# reading docs.
_detach_help() {
    local follow="$1" stop="$2" log="$3"
    echo
    echo "  is it running?   agent-tools status"
    echo "  watch progress   $follow"
    echo "  stop it early    $stop"
    echo
    echo "  When it finishes it EXITS on its own — there is no daemon to clean"
    echo "  up and nothing to kill. The log stays at:"
    echo "      $log"
}

refresh() {
    local root; root="$(git rev-parse --show-toplevel 2>/dev/null)" || { c_bad "not a git repository"; exit 1; }
    cd "$root" || exit 1

    # Flags may combine: `refresh --deep --detach`. Validate BEFORE doing
    # anything — an unrecognised flag used to fall through to the default case
    # and silently start a full semantic pass, i.e. a typo could kick off an
    # hours-long LLM run.
    local mode=full detach=0 a
    for a in "$@"; do
        case "$a" in
            --code-only) mode="--code-only" ;;
            --deep)      mode="--deep" ;;
            --detach)    detach=1 ;;
            full|"")     ;;
            *) c_bad "unknown option for refresh: $a"
               echo "  valid: (none) | --code-only | --deep | --detach"
               exit 2 ;;
        esac
    done

    # Guard AFTER validation, so a typo reports the typo — not "something else
    # is running" — and scoped to this repo, so an unrelated project's run does
    # not block you.
    if graphify_busy_here "$root"; then
        c_bad "a graphify run is already active in this repo: ${BUSY_WHERE:-?}"
        echo "  wait for it, or stop it, then retry"
        exit 1
    fi

    if [ "$detach" = 1 ]; then
        detach_refresh "$mode" "$root"
        return $?
    fi

    hdr "Before"; echo "  $(graph_stats)"

    hdr "1/3 structure"     # LAW: structure first, always
    case "$mode" in
      --code-only)
        graphify update . || exit 1 ;;
      --deep)
        # Deep mode uses its OWN cache namespace (cache/semantic-deep/), so the
        # first deep run re-dispatches every doc even if a standard pass already
        # cached them. That is the cost driver, not the repo size.
        local ndocs; ndocs="$(find . -name '*.md' -not -path './.git/*' -not -path './graphify-out/*' 2>/dev/null | wc -l | tr -d ' ')"
        c_warn "deep mode: aggressive inferred-edge extraction over docs/images."
        c_warn "Its cache namespace starts EMPTY, so the first run re-reads everything."
        c_warn "~$ndocs markdown files here. On a large corpus this runs for hours —"
        c_warn "for that, use scripts/graphify-full-run.sh (detached, retries, resumes)."
        # Deep chunks are big, and the claude-cli backend answers slowly on them.
        # graphify's default API timeout is 600s; a chunk that exceeds it is lost and
        # the whole run lands PARTIAL, which the node-count guard then (correctly)
        # refuses to write. Observed 2026-07-29: chunk 23/26 timed out, the run produced
        # 3341 nodes against an existing 14647, and graphify refused to overwrite.
        # Raise the ceiling, but never override a value the user set deliberately.
        export GRAPHIFY_API_TIMEOUT="${GRAPHIFY_API_TIMEOUT:-1800}"
        c_warn "API timeout for this run: ${GRAPHIFY_API_TIMEOUT}s per chunk"
        graphify extract . --backend claude-cli --mode deep || exit 1 ;;
      *)
        graphify extract . --backend claude-cli || exit 1 ;;
    esac
    c_ok "$(graph_stats)"

    hdr "2/3 labels"        # LAW: `label`, never `cluster-only`; and always LAST
    if [ "$mode" = "--code-only" ]; then c_warn "skipped (code-only); names may be hub-derived"
    else graphify label . --backend claude-cli >/dev/null 2>&1 && c_ok "communities named" || c_warn "label failed"; fi

    hdr "3/3 verify"
    graphify tree >/dev/null 2>&1 && c_ok "GRAPH_TREE.html written"
    local n total
    n="$(graphify query "architecture overview" 2>/dev/null | grep -c '^NODE')"
    total="$("$PY" -c "import json;print(len(json.load(open('graphify-out/graph.json'))['nodes']))" 2>/dev/null || echo 0)"
    # "architecture overview" is a phrase, and a graph is free to contain no
    # node matching it -- this repo does not. Reporting that as a broken graph
    # is a false alarm, and a check that cries wolf gets ignored. So before
    # failing, ask the graph about a symbol it definitely has.
    if [ "${n:-0}" -eq 0 ] && [ "${total:-0}" -gt 0 ]; then
        local probe
        probe="$("$PY" -c "
import json
nodes = json.load(open('graphify-out/graph.json'))['nodes']
name = next((n.get('id') or n.get('name') for n in nodes if (n.get('id') or n.get('name'))), '')
print(name)" 2>/dev/null)"
        [ -n "$probe" ] && n="$(graphify query "$probe" 2>/dev/null | grep -c '^NODE')"
    fi
    if [ "${n:-0}" -gt 0 ]; then
        c_ok "query returns $n nodes — graph answers"
    elif [ "${total:-0}" -lt 25 ]; then
        # A handful of nodes is a real state for a tiny repo, not a failure.
        c_warn "graph is very small ($total nodes) — nothing to match yet, which is fine"
    else
        c_bad "query returned nothing despite $total nodes — investigate"
    fi
}

# ---------------------------------------------------------------------------
# Obsidian export: put BOTH halves of what these tools know into one vault.
#
#   graph    -> `graphify export obsidian --dir VAULT/graph`
#               one note per node/community, wiki-linked, so Obsidian's own
#               graph view renders your codebase structure.
#   memories -> memory-export.py, as notes with YAML front matter, tags and
#               [[links]] on shared concepts.
#
# Deliberately ON DEMAND. Nothing writes to your vault unless you ask, because
# a vault is a place people curate by hand and surprise writes are rude. It is
# also a SNAPSHOT: the vault drifts from the live store until you re-run this,
# and the agent still queries graph.json, never your vault.
# ---------------------------------------------------------------------------
obsidian_export() {
    local vault="${1:-}"
    if [ -z "$vault" ]; then
        c_bad "usage: agent-tools obsidian <vault-dir> [--graph-only|--memory-only]"
        echo "  e.g. agent-tools obsidian ~/Documents/MyVault/agent-tools"
        return 2
    fi
    local mode="${2:-both}"
    local root; root="$(git rev-parse --show-toplevel 2>/dev/null)" || root="$(pwd)"
    local project; project="$(basename "$root")"

    mkdir -p "$vault" || { c_bad "cannot create $vault"; return 1; }
    hdr "Obsidian export -> $vault"

    local did_graph=0 did_mem=0

    if [ "$mode" != "--memory-only" ]; then
        if [ -f "$root/graphify-out/graph.json" ]; then
            local gdir="$vault/$project-graph"
            if (cd "$root" && graphify export obsidian --dir "$gdir" >/dev/null 2>&1); then
                c_ok "graph -> $gdir ($(find "$gdir" -name '*.md' 2>/dev/null | wc -l | tr -d ' ') notes)"
                did_graph=1
            else
                c_warn "graph export failed (is the graph built? agent-tools init)"
            fi
        else
            c_warn "no graph in this project — skipping graph export"
        fi
    fi

    if [ "$mode" != "--graph-only" ]; then
        # A vault with only the graph is half a second brain: structure without
        # the reasoning behind it.
        if [ "$MEMORY_BACKEND" = claude-mem ]; then
            # Reads ~/.claude-mem/claude-mem.db read-only; the worker need not
            # be running, and an export can never mutate the live store.
            memory_export "$vault/memories" >/dev/null 2>&1 \
              && { c_ok "memories -> $vault/memories ($(find "$vault/memories" -name '*.md' 2>/dev/null | wc -l | tr -d ' ') notes)"; did_mem=1; } \
              || c_warn "claude-mem export failed (no store at ~/.claude-mem yet?)"
        else
            c_warn "memory backend not reachable — skipping memories"
        fi
    fi

    # A vault entry point, so the export is navigable rather than a pile.
    {
        printf '# %s — agent-tools export\n\n' "$project"
        printf '_Snapshot taken %s. Re-run `agent-tools obsidian %s` to refresh._\n\n' "$(date '+%Y-%m-%d %H:%M')" "$vault"
        [ "$did_graph" = 1 ] && printf -- '- [[%s-graph/INDEX|Codebase graph]] — structure, communities, god nodes\n' "$project"
        [ "$did_mem" = 1 ]   && printf -- '- [[memories/INDEX|Memories]] — decisions and rationale\n'
        printf '\n> These notes are a snapshot for humans. Agents query the live\n'
        printf '> graph (`graphify-out/graph.json`) and the live memory store,\n'
        printf '> not this vault.\n'
    } > "$vault/INDEX.md"
    c_ok "vault index -> $vault/INDEX.md"
}

# ---------------------------------------------------------------------------
# Memory backend management.
#
# Switching is SYSTEM-WIDE, not per project: a backend hooks the session
# lifecycle at user scope and keeps one machine-global store. A per-project
# split would fragment your history.
#
# Since 3.3.0 there are two settings, claude-mem and none, so `switch` is
# really "capture, or do not". The interesting path is the one-way door out of
# the removed agentmemory backend, which lives in
# memory_migrate_from_agentmemory below: claude-mem has NO ingest API, only its
# own hooks write, so memories cannot simply be POSTed across. We export to
# Markdown (portable, and what an Obsidian vault wants) and then feed
# claude-mem through its own pipeline. Nothing is silently recreated.
# ---------------------------------------------------------------------------
memory_dir_default() { printf '%s' "$(pwd)/memory-export-$(date +%Y%m%d)"; }

# Export whichever backend is active. Both produce Markdown with YAML front
# matter and [[wiki-links]], so a vault looks the same either way -- the point
# of a "second brain" is one place holding BOTH the graph (structure) and the
# memories (reasoning). claude-mem ships no export command, so we read its
# SQLite directly, read-only.
memory_export() {
    local out="${1:-$(memory_dir_default)}"
    local here; here="$(dirname "$(command -v agent-tools 2>/dev/null || echo "$0")")"
    [ -n "$PY" ] || { c_bad "no working python"; return 1; }

    # claude-mem-export.py reads ~/.claude-mem SQLite. memory-export.py talks
    # to a legacy agentmemory server over HTTP -- only reachable while one is
    # still running, which is exactly the migration case.
    local name="claude-mem-export.py"
    [ "$MEMORY_BACKEND" = claude-mem ] || name="memory-export.py"

    local script="$here/$name"
    [ -f "$script" ] || script="$(dirname "$0")/scripts/$name"
    [ -f "$script" ] || { c_bad "$name not found next to agent-tools"; return 1; }

    if [ "$MEMORY_BACKEND" = claude-mem ]; then
        "$PY" "$script" "$out"          # positional outdir
    else
        "$PY" "$script" --out "$out"
    fi
}

# Stop AND disable a legacy agentmemory service, so a backend nothing writes to
# is not left supervised. The STORE is never deleted.
am_legacy_stop_service() {
    case "$PLATFORM" in
        macos)
            launchctl bootout "gui/$(id -u)/$AM_LEGACY_LABEL" 2>/dev/null
            [ -f "$AM_LEGACY_PLIST" ] && { mv "$AM_LEGACY_PLIST" "$AM_LEGACY_PLIST.disabled" 2>/dev/null \
                && c_ok "launchd job disabled (plist kept as .disabled)"; } ;;
        linux|wsl)
            has_systemd && { systemctl --user disable --now agentmemory.service 2>/dev/null \
                && c_ok "systemd unit disabled"; }
            [ -f "$AM_LEGACY_UNIT" ] && { mv "$AM_LEGACY_UNIT" "$AM_LEGACY_UNIT.disabled" 2>/dev/null \
                && c_ok "systemd unit file kept as .disabled"; } ;;
    esac
    # LAW (historical): the server must be stopped from its own directory.
    ( cd "$AM_LEGACY" 2>/dev/null && agentmemory stop --force >/dev/null 2>&1 )
    if have claude && claude plugin list 2>/dev/null | grep -q "agentmemory@agentmemory"; then
        # `uninstall` FAILS when the plugin is enabled at PROJECT scope (it lives
        # in a repo's .claude/settings.json, shared with the team). Disabling at
        # local scope always works and stops the hooks immediately, which is what
        # actually matters. Observed 2026-07-29.
        if claude plugin uninstall agentmemory@agentmemory >/dev/null 2>&1; then
            c_ok "agentmemory plugin removed (its hooks no longer fire)"
        elif claude plugin disable agentmemory@agentmemory --scope local >/dev/null 2>&1; then
            c_ok "agentmemory plugin disabled for you (hooks stopped)"
            c_warn "It is still enabled in a project's .claude/settings.json."
            c_warn "Remove \"agentmemory@agentmemory\" from enabledPlugins there so the"
            c_warn "repo does not load a backend you no longer use."
        else
            c_warn "could not disable the plugin — do it manually:"
            c_warn "    claude plugin disable agentmemory@agentmemory --scope local"
        fi
    fi
    if claude mcp list 2>/dev/null | grep -q "^agentmemory"; then
        claude mcp remove agentmemory -s local >/dev/null 2>&1 \
            && c_ok "stale agentmemory MCP entry removed" \
            || c_warn "remove the MCP entry yourself: claude mcp remove agentmemory -s local"
    fi
    c_ok "agentmemory store preserved at $AM_LEGACY (nothing deleted)"
}

# ---------------------------------------------------------------------------
# The one-way door out of the removed agentmemory backend.
#
# THIS IS DESTRUCTIVE TO THE SERVICE, NOT TO THE DATA. It stops and disables a
# supervised agentmemory, disables its plugin hooks, removes its MCP entry, and
# imports what it can into claude-mem. ~/.agentmemory is left byte-for-byte
# intact, and a Markdown export is written first so there is a record that
# outlives both tools.
# ---------------------------------------------------------------------------
memory_migrate_from_agentmemory() {
    hdr "Migrating off agentmemory (removed in 3.3.0)"
    if ! am_legacy_installed; then
        c_ok "no agentmemory install found at $AM_LEGACY — nothing to migrate"
        return 0
    fi
    c_warn "This stops and disables the agentmemory service and its Claude Code"
    c_warn "hooks. Your store at $AM_LEGACY is NOT deleted."
    confirm "to migrate off agentmemory now" || { c_warn "aborted — nothing changed"; return 0; }

    # 1. Export first. The exact record, before anything is touched.
    hdr "1/3 export the agentmemory store"
    local out; out="$HOME/agentmemory-export-$(date +%Y%m%d)"
    if curl -sf -m 5 http://localhost:3111/agentmemory/health >/dev/null 2>&1; then
        MEMORY_BACKEND=agentmemory memory_export "$out" >/dev/null 2>&1 \
            && c_ok "exported to $out" \
            || c_warn "export failed — the store at $AM_LEGACY is still intact"
    else
        c_warn "server not responding on :3111, so there is nothing to export over HTTP."
        c_warn "Start it once to export:  cd $AM_LEGACY && agentmemory --tools core &"
    fi

    # 2. Import through claude-mem's own pipeline.
    hdr "2/3 import into claude-mem"
    local conv; conv="$(dirname "$(command -v agent-tools 2>/dev/null || echo "$0")")/agentmemory-to-claude-mem.py"
    [ -f "$conv" ] || conv="$(dirname "$0")/scripts/agentmemory-to-claude-mem.py"
    if [ -f "$conv" ] && [ -n "$PY" ]; then
        c_warn "claude-mem has no ingest API. Converting via its own hook pipeline"
        c_warn "(it SUMMARISES on ingest, so text is compressed, not verbatim —"
        c_warn " the Markdown export above stays the exact record)."
        "$PY" "$conv" --cwd "$(pwd)" --dry-run 2>&1 | sed 's/^/    /'
        if confirm "the converted memories into claude-mem now"; then
            "$PY" "$conv" --cwd "$(pwd)" --go 2>&1 | sed 's/^/    /'
        else
            c_warn "skipped — run later:  $conv --go"
        fi
    else
        c_warn "converter not found; your Markdown export is the record"
    fi
    c_warn "To also replay raw past sessions (optional, costs tokens):"
    c_warn "    scripts/claude-mem-import-transcripts.sh   # dry run first"

    # 3. Retire the service.
    hdr "3/3 retire the agentmemory service"
    am_legacy_stop_service
    if [ "$MEMORY_BACKEND" != claude-mem ]; then
        if cm_installed; then c_ok "claude-mem already installed"
        elif confirm "claude-mem (so something is still capturing)"; then
            npx -y claude-mem install >/dev/null 2>&1 \
              && c_ok "claude-mem installed (wires its own hooks + MCP)" \
              || c_bad "install failed — try: npx claude-mem install"
        fi
        remember_backend claude-mem
    fi
    c_ok "done — backend is claude-mem, agentmemory data preserved"
    echo "  Restart Claude Code so hook changes take effect."
}

memory_switch() {
    local target="${1:-}"
    case "$target" in
        claude-mem|none) ;;
        agentmemory)
            c_bad "agentmemory was removed in 3.3.0 and cannot be switched back on."
            c_warn "To move an existing store into claude-mem:"
            c_warn "    agent-tools memory migrate-from-agentmemory"
            return 2 ;;
        *) c_bad "usage: agent-tools memory switch <claude-mem|none>"; return 2 ;;
    esac
    local current="$MEMORY_BACKEND"
    [ "$current" = "$target" ] && { c_ok "already using $target"; return 0; }

    hdr "Switching memory backend: $current -> $target"
    c_warn "This is machine-wide. Memory spans projects, so it cannot be per-project."

    # Always export first — a portable record that outlives either setting.
    hdr "1/2 export current memories"
    if [ "$current" = claude-mem ] && cm_installed; then
        local out; out="$HOME/claude-mem-export-$(date +%Y%m%d)"
        memory_export "$out" >/dev/null 2>&1 && c_ok "exported to $out" \
            || c_warn "export failed (no store at ~/.claude-mem yet?)"
    else
        c_warn "nothing to export (no active backend)"
    fi

    hdr "2/2 switch over"
    case "$target" in
      claude-mem)
        if cm_installed; then c_ok "claude-mem already installed"
        elif confirm "claude-mem"; then
            npx -y claude-mem install >/dev/null 2>&1 \
              && c_ok "claude-mem installed (wires its own hooks + MCP)" \
              || c_bad "install failed — try: npx claude-mem install"
        fi ;;
      none)
        # Stop capture without uninstalling: the store stays readable and
        # switching back costs nothing.
        have npx && npx claude-mem stop >/dev/null 2>&1 \
            && c_ok "claude-mem worker stopped (store kept at ~/.claude-mem)" \
            || c_warn "stop the worker yourself: npx claude-mem stop"
        c_warn "claude-mem's hooks are still installed. To remove them entirely:"
        c_warn "    npx claude-mem uninstall" ;;
    esac
    remember_backend "$target"
    c_ok "backend is now: $target"
    echo "  Restart Claude Code so hook changes take effect."
}

# ---------------------------------------------------------------------------
# Is a run active in THIS repo, and what has it done so far?
status_cmd() {
    local root; root="$(git rev-parse --show-toplevel 2>/dev/null)" || { c_bad "not a git repository"; exit 1; }
    local log="$root/.git/graphify-refresh.log"; [ -f "$log" ] || log="$root/graphify-refresh.log"
    hdr "Refresh status — $(basename "$root")"
    if graphify_busy_here "$root"; then
        local pid; pid="$(printf '%s' "${BUSY_WHERE:-}" | sed -n 's/.*pid \([0-9]*\).*/\1/p')"
        local et; et="$(ps -o etime= -p "${pid:-0}" 2>/dev/null | tr -d ' ')"
        c_ok "RUNNING${et:+ — $et elapsed}${pid:+ (pid $pid)}"
        # Low CPU is normal: it blocks on the LLM, not the processor.
        echo "  note: low CPU is expected — it waits on the model, it does not compute"
    else
        c_ok "no run active in this repo"
    fi
    echo "  graph : $(cd "$root" && graph_stats)"
    if [ -f "$log" ]; then
        echo "  log   : $log"
        local chunks; chunks="$(grep -cE 'chunk [0-9]+/[0-9]+ done' "$log" 2>/dev/null)"
        local total;  total="$(grep -oE 'chunk [0-9]+/[0-9]+ done' "$log" 2>/dev/null | tail -1 | sed 's|.*/||;s| done||')"
        [ "${chunks:-0}" -gt 0 ] && echo "  chunks: ${chunks}${total:+/$total} done"
        echo "  last  :"; tail -3 "$log" 2>/dev/null | sed 's/^/      /'
    else
        echo "  log   : none (no detached run has been started here)"
    fi
}

# Stop a run in THIS repo only — never another project's.
stop_cmd() {
    local root; root="$(git rev-parse --show-toplevel 2>/dev/null)" || { c_bad "not a git repository"; exit 1; }
    if ! graphify_busy_here "$root"; then c_ok "nothing running in this repo"; return 0; fi
    local pid; pid="$(printf '%s' "${BUSY_WHERE:-}" | sed -n 's/.*pid \([0-9]*\).*/\1/p')"
    if [ -z "$pid" ]; then c_bad "could not identify the pid (${BUSY_WHERE:-?})"; return 1; fi
    kill "$pid" 2>/dev/null; sleep 3
    kill -0 "$pid" 2>/dev/null && { kill -9 "$pid" 2>/dev/null; sleep 1; }
    if graphify_busy_here "$root"; then c_bad "still running — check manually"; return 1; fi
    c_ok "stopped (pid $pid)"
    echo "  Completed files stay cached, so re-running resumes rather than restarting."
}

# ---------------------------------------------------------------------------
# version — what you are running, when it was released, when it landed here.
#
# Three DIFFERENT dates, and conflating them is how "I already updated" turns
# into an hour of confusion:
#   released   the version's own release date, baked into the file
#   installed  when install.sh last wrote the copy on your PATH
#   source     the checkout's HEAD, which can be AHEAD of both if you pulled
#              and forgot to re-run install.sh
# ---------------------------------------------------------------------------

# stat has no portable format string: BSD/macOS uses -f, GNU uses -c.
file_mtime() {
    [ -e "$1" ] || return 1
    stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$1" 2>/dev/null && return 0
    stat -c '%y' "$1" 2>/dev/null | cut -d: -f1,2 && return 0
    return 1
}

version_cmd() {
    if [ "$SHORT_OUTPUT" = 1 ]; then printf '%s\n' "$VERSION"; return 0; fi

    printf 'agent-tools %s   (released %s)\n' "$VERSION" "$VERSION_DATE"

    # The file that is actually running. $0 for a direct call, whatever is on
    # PATH otherwise -- report the one the user would get by typing the name.
    local self; self="$(command -v agent-tools 2>/dev/null)"
    [ -n "$self" ] || self="$0"
    if [ -e "$self" ]; then
        local when; when="$(file_mtime "$self")"
        printf '  installed  %s\n' "${when:-unknown}"
        printf '             %s\n' "$self"
        # A copy on PATH that is OLDER than the checkout means install.sh was
        # not re-run after a pull. Silent divergence, so say it.
        local sv
        sv="$(sed -n 's/^VERSION=//p' "$self" 2>/dev/null | head -1)"
        if [ -n "$sv" ] && [ "$sv" != "$VERSION" ]; then
            c_warn "the copy on your PATH is $sv, but this file is $VERSION"
            c_warn "    re-run ./install.sh from the checkout"
        fi
    fi

    local rec; rec="$(recorded_source 2>/dev/null)"
    if [ -n "$rec" ] && [ -d "$rec/.git" ]; then
        local head hdate
        head="$(git -C "$rec" rev-parse --short HEAD 2>/dev/null)"
        hdate="$(git -C "$rec" log -1 --format=%cd --date=format:'%Y-%m-%d %H:%M' 2>/dev/null)"
        printf '  source     %s\n' "$rec"
        [ -n "$head" ] && printf '             HEAD %s  (%s)\n' "$head" "${hdate:-unknown}"
        if ! git -C "$rec" diff --quiet 2>/dev/null; then
            c_warn "the checkout has uncommitted changes"
        fi
    elif [ -n "$rec" ]; then
        c_warn "recorded checkout is gone: $rec"
        c_warn "    re-run ./install.sh from wherever it lives now"
    else
        c_warn "no checkout recorded — run ./install.sh once from your clone"
    fi
    return 0
}

case "${1:-help}" in
    doctor)            doctor ;;
    install-machine)   install_machine ;;
    caveman)           shift; caveman_cmd "${1:-status}" ;;
    pocock)            shift; pocock_cmd "${1:-status}" ;;
    tools)             tools_cmd ;;
    install)           shift; install_tool_cmd "$(first_nonflag "$@")" ;;
    uninstall|remove)  shift; uninstall_tool_cmd "$(first_nonflag "$@")" ;;
    wire)              shift; wire_tool_cmd wire "$(first_nonflag "$@")" ;;
    unwire)            shift; wire_tool_cmd unwire "$(first_nonflag "$@")" ;;
    update|upgrade)    shift; update_cmd "$(first_nonflag "$@")" ;;
    migrate)           shift; migrate_cmd "${1:-}" "${2:-}" ;;
    init)              init_project ;;
    refresh)           shift; refresh "$@" ;;
    status)            shift
                       case "${1:-}" in
                         refresh) status_cmd ;;
                         *) inventory_cmd
                            # The refresh view only means anything inside a
                            # repo, so show it when we are in one and stay
                            # quiet rather than erroring when we are not.
                            if [ -n "$(repo_root)" ]; then echo; status_cmd; fi ;;
                       esac ;;
    inventory|list)    inventory_cmd ;;
    agents)            agents_cmd ;;
    obsidian)          shift; obsidian_export "${1:-}" "${2:-both}" ;;
    memory)            shift
                       case "${1:-status}" in
                         export) shift; memory_export "${1:-}" ;;
                         switch) shift; memory_switch "${1:-}" ;;
                         migrate-from-agentmemory) memory_migrate_from_agentmemory ;;
                         status) echo "  backend: $MEMORY_BACKEND"
                                 cm_installed && echo "  claude-mem : installed" || echo "  claude-mem : not installed"
                                 if am_legacy_installed; then
                                     am_legacy_active \
                                       && echo "  agentmemory: LEGACY, still capturing — agent-tools memory migrate-from-agentmemory" \
                                       || echo "  agentmemory: legacy install present, inactive (removed in 3.3.0)"
                                 fi ;;
                         *) echo "usage: agent-tools memory <status|export|switch|migrate-from-agentmemory>"; exit 2 ;;
                       esac ;;
    stop)              stop_cmd ;;
    platform)          echo "$PLATFORM" ;;   # used by the self-test
    help|--help|-h)    usage; long_help ;;
    version)           version_cmd ;;
    --version)         echo "agent-tools $VERSION" ;;
    *) usage; exit 2 ;;
esac
