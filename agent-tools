#!/usr/bin/env bash
# ===========================================================================
# agent-tools — set up graphify + claude-mem for ANY project, on any platform.
#
# One self-contained file. No dependencies beyond bash, python3, and the tools
# it installs.
#
#   agent-tools doctor            what's installed / what's wrong  (safe)
#   agent-tools install-machine   one-time per COMPUTER
#   agent-tools init              one-time per PROJECT (run inside the repo)
#   agent-tools refresh           update this project's graph, in order
#   agent-tools tools             every optional tool: installed? wired? where?
#   agent-tools install NAME      add one tool (--project = this repo only)
#   agent-tools update NAME|all   upgrade one tool, or everything installed
#   agent-tools help              long help, with the reasoning
#
# PLATFORM SUPPORT
#   macOS          full
#   Linux          full
#   WSL2           full
#   Windows native PARTIAL      no rtk binary by default — see `agent-tools help`
#
#   Since 3.3.0 there is no supervised memory server: claude-mem runs its own
#   worker and needs no launchd/systemd unit from us. That removed the last
#   hard blocker on native Windows; what remains is rtk, which needs either
#   Rust or the release zip on PATH.
#
# Every default here comes from an observed failure. The ones that will bite you
# if changed are marked LAW.
# ===========================================================================
set -uo pipefail
# VERSION / VERSION_DATE are the RELEASE identity and are bumped by hand at
# release time. They must not be derived from git: the file that actually runs
# on a user's machine is the copy install.sh drops in ~/.local/bin, which has
# no repository around it and cannot ask git anything.
VERSION=3.4.0
VERSION_DATE=2026-08-20

# Where this thing lives. `update self` uses it to pull, or to clone a fresh
# copy on a machine that installed from a downloaded archive and therefore has
# no checkout to pull into.
REPO_URL="https://github.com/AgentTooligans/AgentTools"

BIN="$HOME/.local/bin"
# Where a pre-3.3.0 agentmemory install left its store. We no longer install,
# supervise or update agentmemory, but `doctor` still looks here so an old
# install that is still capturing gets reported instead of silently fighting
# claude-mem for the same transcripts.
AM_LEGACY="$HOME/.agentmemory"

c_ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
c_bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; }
c_warn() { printf '  \033[33m!\033[0m %s\n' "$1"; }
hdr()    { printf '\n\033[1m== %s ==\033[0m\n' "$1"; }
have()   { command -v "$1" >/dev/null 2>&1; }
# Subcommand arguments and flags arrive in any order (`install rtk --project`
# and `install --project rtk` are both things people type). Flags are already
# parsed globally, so the subcommand only needs the first non-flag word.
first_nonflag() {
    local a
    for a in "$@"; do case "$a" in --*|-y) ;; *) printf '%s' "$a"; return 0 ;; esac; done
    return 0
}

# WSL inherits the WINDOWS PATH, so `node`/`npm` frequently resolve to
# /mnt/c/Program Files/nodejs/... — Windows binaries running under Linux paths.
# Installing through them puts packages in the WINDOWS npm prefix
# (/mnt/c/Users/<you>/AppData/Roaming/npm) and any Linux service pointed at the
# result FAILS while every check still looks green. Observed on real WSL2
# 2026-07-29: a memory server "installed" to /mnt/c/... and its unit died.
# So inside WSL a Windows-hosted binary counts as NOT INSTALLED.
have_native() {
    local p; p="$(command -v "$1" 2>/dev/null)" || return 1
    [ -n "$p" ] || return 1
    if [ "$PLATFORM" = wsl ]; then
        case "$p" in /mnt/*) return 1 ;; esac
    fi
    return 0
}
# Where a command actually lives, for honest reporting.
where_is() { command -v "$1" 2>/dev/null || echo "not found"; }

export PATH="$BIN:/opt/homebrew/bin:/usr/local/bin:$PATH"

# ---------------------------------------------------------------------------
# Consent for installs.
#   default    ask before installing anything
#   --yes/-y   install everything without asking (CI, unattended)
#   --no-install  never install; just report what is missing
# Non-interactive with no --yes SKIPS rather than blocks: a script that hangs
# forever waiting on a prompt nobody can answer is worse than one that stops.
# ---------------------------------------------------------------------------
ASSUME_YES=0
NO_INSTALL=0

# ---------------------------------------------------------------------------
# Memory backend. One tool does this job now.
#
#   claude-mem   default. Runs a worker on :37701 (start with `npx claude-mem
#                start` — no launchd/systemd unit needed, and no cwd trap),
#                injects context at session start. No bulk importer: it starts
#                from install day. Ships /learn-codebase to ingest a repo.
#   none         graphify only, nothing captures sessions.
#
# REMOVED IN 3.3.0: agentmemory. It was the only thing here that needed a
# supervised server, and the working-directory-decides-the-store trap behind it
# produced most of this file's scar tissue: a launchd plist, a systemd unit, a
# cwd-sensitive start command, and a native-Windows blocker. Existing installs
# are NOT deleted — `doctor` still reports one that is still capturing, and
# scripts/agentmemory-to-claude-mem.py still migrates the store. See
# `agent-tools memory migrate-from-agentmemory`.
#
# Resolution order: --memory flag > saved choice > default.
# ---------------------------------------------------------------------------
AT_CONFIG_DIR="$HOME/.config/agent-tools"
AT_CONFIG="$AT_CONFIG_DIR/config"
MEMORY_DEFAULT="claude-mem"
MEMORY_BACKEND=""
SKIP_CAVEMAN=0
FORCE_IMPORT=0
# ---------------------------------------------------------------------------
# Optional tools that install-machine adds by default, and the flags to skip
# each one. They are separate flags rather than one --no-extras because people
# skip them for different reasons: rtk because they already have a Bash hook
# they care about, context-mode because Node is old, superpowers because they
# do not want more skills in context.
# ---------------------------------------------------------------------------
SKIP_RTK=0
SKIP_SUPERPOWERS=0
SKIP_CONTEXT_MODE=0
SKIP_POCOCK=0
# --project: install/activate for THIS REPO only, never machine-wide. Binaries
# are still shared (a uv tool or a brew formula has no per-project form) --
# what changes is where the ACTIVATION lands: repo .claude/settings.json,
# project-scope plugins, `-s local` MCP entries.
SCOPE_PROJECT=0
# uninstall data handling: neither set = ask; --purge = delete without asking;
# --keep-data = never delete. Both set is a contradiction, resolved in favour
# of keeping, because the destructive reading of an ambiguous command is the
# wrong one to guess.
PURGE_DATA=0
# --purge alone covers MACHINE-WIDE data only. Per-repo data (a repo's
# graphify-out/, its parsed indexes) needs --purge-repo on top, because those
# paths depend on where you are standing when you type the command -- and a
# --purge run from inside the wrong repo is how this project lost a graph.
PURGE_REPO=0
KEEP_DATA=0
SHORT_OUTPUT=0
# MCP is OPT-IN as of 3.4.0. `init` wires no server unless you ask for one.
#
# WHY THE DEFAULT FLIPPED
#   An MCP server re-sends its whole tool schema EVERY session whether or not
#   it is called -- graphify's is ~1.5k tokens. The CLI answers the same
#   questions from the same graph.json for zero standing cost, and works in
#   every agent rather than Claude Code alone. Paying a per-session tax by
#   default, for a capability most repos use occasionally, is the exact tax
#   this project exists to avoid.
#
#   `--add-mcp` opts a repo in. `--no-mcp` is still accepted and is now a no-op
#   naming the default, because it was the documented spelling before 3.4.0.
ADD_MCP=0
for _a in "$@"; do
    case "$_a" in
        --memory=*) MEMORY_BACKEND="${_a#--memory=}" ;;
        --no-caveman) SKIP_CAVEMAN=1 ;;
        --no-rtk) SKIP_RTK=1 ;;
        --no-superpowers) SKIP_SUPERPOWERS=1 ;;
        --no-context-mode) SKIP_CONTEXT_MODE=1 ;;
        --no-pocock) SKIP_POCOCK=1 ;;
        --project|--local) SCOPE_PROJECT=1 ;;
        --force) FORCE_IMPORT=1 ;;
        --purge) PURGE_DATA=1 ;;
        --purge-repo) PURGE_DATA=1; PURGE_REPO=1 ;;
        --keep-data) KEEP_DATA=1 ;;
        --short) SHORT_OUTPUT=1 ;;
        --add-mcp|--mcp) ADD_MCP=1 ;;
        --no-mcp|--cli) ADD_MCP=0 ;;
    esac
done
if [ -z "$MEMORY_BACKEND" ] && [ -f "$AT_CONFIG" ]; then
    MEMORY_BACKEND="$(sed -n 's/^memory_backend=//p' "$AT_CONFIG" 2>/dev/null | tail -1)"
fi
MEMORY_BACKEND="${MEMORY_BACKEND:-$MEMORY_DEFAULT}"
case "$MEMORY_BACKEND" in
    claude-mem|none) ;;
    # A config file written before 3.3.0 can still say agentmemory. Do not hard
    # fail on it -- that would break `doctor` on exactly the machine that most
    # needs to run it. Fall back to the default and say so once.
    agentmemory)
        printf '  memory backend "agentmemory" was removed in 3.3.0 — using %s\n' "$MEMORY_DEFAULT"
        printf '  your old store is untouched: agent-tools memory migrate-from-agentmemory\n'
        MEMORY_BACKEND="$MEMORY_DEFAULT" ;;
    *) printf '  unknown --memory value: %s (use claude-mem | none)\n' "$MEMORY_BACKEND"; exit 2 ;;
esac
# Where the git checkout lives. install.sh copies the script to ~/.local/bin,
# so $0 at runtime is the COPY and knows nothing about its source -- which made
# `update self` always fall through to "not running from a git checkout" on
# every properly installed machine. install.sh records the path here.
remember_source() {
    mkdir -p "$AT_CONFIG_DIR" 2>/dev/null
    if [ -f "$AT_CONFIG" ]; then
        grep -v '^source_checkout=' "$AT_CONFIG" > "$AT_CONFIG.tmp" 2>/dev/null || true
        mv "$AT_CONFIG.tmp" "$AT_CONFIG" 2>/dev/null
    fi
    printf 'source_checkout=%s\n' "$1" >> "$AT_CONFIG"
}
recorded_source() {
    [ -f "$AT_CONFIG" ] || return 1
    sed -n 's/^source_checkout=//p' "$AT_CONFIG" 2>/dev/null | tail -1
}

remember_backend() {
    mkdir -p "$AT_CONFIG_DIR" 2>/dev/null
    if [ -f "$AT_CONFIG" ]; then
        grep -v '^memory_backend=' "$AT_CONFIG" > "$AT_CONFIG.tmp" 2>/dev/null || true
        mv "$AT_CONFIG.tmp" "$AT_CONFIG" 2>/dev/null
    fi
    printf 'memory_backend=%s\n' "$1" >> "$AT_CONFIG"
}

cm_installed() { have claude-mem || [ -d "$HOME/.claude-mem" ]; }
# We no longer install agentmemory, but a machine upgraded from <3.3.0 can
# still have one running. Keep detecting it: two capturing backends means
# double capture and double per-tool-call overhead, and the user deserves to
# be told which one to stop.
am_legacy_installed() { have agentmemory || [ -d "$AM_LEGACY/data" ]; }

# INSTALLED is not the problem — ACTIVE is. A backend that is present but has
# its hooks disabled and its service stopped costs nothing and is a useful
# archive. Only two *capturing* backends duplicate work. Warning on mere
# presence cries wolf at exactly the person who did the right thing.
cm_active() { curl -sf -m 3 http://127.0.0.1:37701 >/dev/null 2>&1; }
am_legacy_active() {
    curl -sf -m 3 http://localhost:3111/agentmemory/health >/dev/null 2>&1 && return 0
    # Plugin enabled (not merely installed) also means hooks fire.
    have claude || return 1
    claude plugin list 2>/dev/null | grep -A3 "agentmemory@agentmemory" | grep -qi "enabled"
}
for _a in "$@"; do
    case "$_a" in
        -y|--yes)     ASSUME_YES=1 ;;
        --no-install) NO_INSTALL=1 ;;
    esac
done

confirm() {   # confirm "<what>" -> 0 = go ahead
    if [ "$NO_INSTALL" = 1 ]; then c_warn "missing: $1  (--no-install set; skipping)"; return 1; fi
    if [ "$ASSUME_YES" = 1 ]; then c_warn "installing: $1"; return 0; fi

    # Is there REALLY a terminal? `[ -r /dev/tty ]` is not enough: in a container
    # the device node exists and looks readable, but opening it fails with ENXIO
    # when there is no controlling terminal. That false positive made a
    # non-interactive run take the prompt path and install without consent.
    local src=""
    if [ -t 0 ]; then src="stdin"
    elif { : < /dev/tty; } 2>/dev/null; then src="tty"; fi

    if [ -z "$src" ]; then
        c_warn "missing: $1  (non-interactive — re-run with --yes to install)"
        return 1
    fi

    printf '  \033[33m?\033[0m Install %s? [Y/n] ' "$1"
    local reply=""
    # FAIL CLOSED: if the read fails (EOF, closed pipe, unusable tty) that is a
    # non-answer and must mean "no". Only a successful read counts as consent —
    # an empty reply then is the user pressing Enter, which is the [Y/n] default.
    if [ "$src" = tty ]; then
        read -r reply < /dev/tty || { echo; c_warn "no answer — skipping $1"; return 1; }
    else
        read -r reply || { echo; c_warn "no answer — skipping $1"; return 1; }
    fi
    case "$reply" in [nN]*) c_warn "skipped: $1"; return 1 ;; *) return 0 ;; esac
}

# ---------------------------------------------------------------------------
# Platform detection. Everything platform-specific dispatches on PLATFORM.
# ---------------------------------------------------------------------------
detect_platform() {
    local s; s="$(uname -s 2>/dev/null || echo unknown)"
    case "$s" in
        Darwin) echo macos ;;
        Linux)
            # WSL reports Linux; the giveaway is "microsoft" in the kernel
            # string (WSL1 and WSL2 both) or the distro env var.
            if grep -qiE "microsoft|wsl" /proc/version 2>/dev/null || [ -n "${WSL_DISTRO_NAME:-}" ]; then
                echo wsl
            else
                echo linux
            fi ;;
        MINGW*|MSYS*|CYGWIN*) echo windows ;;
        *) echo unknown ;;
    esac
}
PLATFORM="$(detect_platform)"

# systemd --user is not a given: WSL needs systemd=true in /etc/wsl.conf, and
# some containers/distros run without it. Check before relying on it.
has_systemd() {
    have systemctl || return 1
    [ -d /run/systemd/system ] || return 1
    systemctl --user show-environment >/dev/null 2>&1
}

# pgrep is absent on Git Bash; fall back to ps.
proc_running() {
    if have pgrep; then pgrep -f "$1" >/dev/null 2>&1
    else ps -ef 2>/dev/null | grep -E "$1" | grep -qv grep; fi
}

# Is a graphify run active IN THIS REPO?
#
# The old check matched any graphify process anywhere on the machine, so
# indexing project A blocked a refresh in unrelated project B — observed
# 2026-07-29. Two writers on ONE graphify-out/ is the real hazard, so scope the
# check by the process's working directory.
#
# If a pid's cwd cannot be determined we treat it as blocking: a false "wait"
# costs you a minute, a false "go ahead" can corrupt a graph.
# The bracket around the y is deliberate. `$(pgrep -f "$GRAPHIFY_PROCS")` forks
# a subshell whose OWN command line contains this pattern text, so a literal
# pattern matches that subshell — and its cwd is whatever repo you are checking,
# producing a phantom "a run is active in this repo" (seen 2026-07-29).
# "graphif[y]" still matches the string "graphify" as a regex, but the pattern
# text itself does not, so the subshell is invisible to it.
GRAPHIFY_PROCS="graphif[y] (extract|update|label|cluster-only|watch)"
graphify_busy_here() {
    local repo="$1" pid cwd
    have pgrep || { proc_running "$GRAPHIFY_PROCS"; return $?; }
    for pid in $(pgrep -f "$GRAPHIFY_PROCS" 2>/dev/null); do
        [ "$pid" = "$$" ] && continue
        [ "$pid" = "$PPID" ] && continue
        cwd=""
        if [ -r "/proc/$pid/cwd" ]; then
            cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null)"
        elif have lsof; then
            cwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
        fi
        if [ -z "$cwd" ]; then
            BUSY_WHERE="(unknown cwd, pid $pid)"; return 0
        fi
        case "$cwd" in
            "$repo"|"$repo"/*) BUSY_WHERE="$cwd (pid $pid)"; return 0 ;;
        esac
    done
    return 1
}

# Pick a python that actually RUNS, not merely one that exists.
#
# On Windows, `python3` is usually the Microsoft Store "App Execution Alias" —
# a stub on PATH that is NOT an interpreter. It answers every invocation with
# "Python was not found; run without arguments to install from the Microsoft
# Store", so an existence check picks it over the real `python` sitting right
# next to it. Observed in Git Bash on Windows 11, 2026-07-29:
#     python3 -> AppData/Local/Microsoft/WindowsApps/python3    (stub, broken)
#     python  -> AppData/Local/Programs/Python/Python312/python (real, 3.12.10)
# `py` is the Windows Python launcher, a reasonable last resort.
_pick_python() {
    local c
    for c in python3 python py; do
        command -v "$c" >/dev/null 2>&1 || continue
        "$c" -c "pass" >/dev/null 2>&1 && { printf '%s' "$c"; return 0; }
    done
    # Last resort: a uv-managed interpreter. uv is already a dependency here, so
    # this needs no extra package manager and works on every platform — useful
    # on Windows, where a system Python is not a given.
    if command -v uv >/dev/null 2>&1; then
        local up; up="$(uv python find 2>/dev/null | head -1)"
        if [ -n "$up" ] && [ -x "$up" ] && "$up" -c "pass" >/dev/null 2>&1; then
            printf '%s' "$up"; return 0
        fi
    fi
    printf ''
}
PY="$(_pick_python)"

# Service definitions a pre-3.3.0 agent-tools may have written. Nothing here
# creates them any more; they exist so `memory migrate-from-agentmemory` can
# find and disable one that is still running.
AM_LEGACY_LABEL="com.agentmemory.server"
AM_LEGACY_PLIST="$HOME/Library/LaunchAgents/$AM_LEGACY_LABEL.plist"
AM_LEGACY_UNIT_DIR="$HOME/.config/systemd/user"
AM_LEGACY_UNIT="$AM_LEGACY_UNIT_DIR/agentmemory.service"

# ---------------------------------------------------------------------------
usage() {
cat <<'USAGE'
agent-tools — graphify + claude-mem, set up correctly, on any project.

  agent-tools doctor            report only; changes nothing
  agent-tools install-machine   once per computer
  agent-tools init              once per project (run from inside the repo).
                                Wires NO MCP server: the agent uses the CLI,
                                which costs 0 tokens per session and works in
                                every agent, not just Claude Code
  agent-tools init --add-mcp    same, plus graphify's MCP server for THIS repo
                                (~1.5k tokens every session, Claude Code only)
  agent-tools agents            which agents are installed, and how each one
                                gets these tools without an MCP server
  agent-tools refresh           refresh this project's graph, in the right order
  agent-tools status            what is installed, what is not, and versions
  agent-tools status refresh    is a refresh running here? how far along?
  agent-tools version           version, release date, and when it was installed
  agent-tools stop              stop a run in THIS repo (other projects untouched)
  agent-tools memory status     which backend, what is installed
  agent-tools memory export     memories -> portable Markdown (Obsidian-ready)
  agent-tools memory switch X   change backend machine-wide (claude-mem|none)
  agent-tools memory migrate-from-agentmemory
                                one-time: pull a pre-3.3.0 agentmemory store
                                into claude-mem and retire its service
  agent-tools obsidian DIR      export graph + memories into an Obsidian vault
  agent-tools tools             every optional tool: installed? wired? overlapping?
  agent-tools install NAME      install one tool (or: defaults | all)
  agent-tools uninstall NAME    remove one tool (or: all) — asks before
                                deleting anything it recorded
  agent-tools wire NAME         add a tool's MCP to THIS project (crg|token-savior)
  agent-tools unwire NAME       remove it from this project
  agent-tools caveman [CMD]     output-token compression: status|install|update|uninstall
  agent-tools pocock [CMD]      grill-me/handoff/wait-what: status|install|update|uninstall
  agent-tools update [WHAT]     update one thing, or everything installed
  agent-tools migrate export    archive what git cannot carry (memory, keys, ~/.claude)
  agent-tools migrate import F  restore that archive on a new computer
  agent-tools help              the reasoning behind every default

Tools (agent-tools install <name>):
  default (install-machine adds these):
    rtk            filters Bash output before it reaches the model
    superpowers    skills library (TDD, debugging, planning)
    context-mode   sandboxes tool output, survives compaction (Node >= 22.5)
    caveman        compresses what the agent SAYS BACK
    pocock         4 skills: /grill-me, /handoff, /wait-what (+ grilling)
  opt-in (they duplicate graphify and each other — docs/TOOLS.md):
    code-review-graph   second code graph, 30 MCP tools
    token-savior        third code graph + its own memory engine

Versions (see docs/UPDATING.md):
  agent-tools version           the full picture: released / installed / source
  agent-tools version --short   just the number, for scripts
  agent-tools status            every managed tool with its version, plus what
                                is available but not installed
  ./install.sh --version        what a checkout would install, without doing it
  A version has three dates and they can all differ: RELEASED is baked into
  the file, INSTALLED is when install.sh last wrote your PATH copy, SOURCE is
  the checkout's HEAD. `version` prints all three and warns when they diverge.

Removing (see docs/UPDATING.md):
  agent-tools uninstall NAME    one tool, plugin, skill pack or MCP server
  agent-tools uninstall all     everything agent-tools installed, after showing
                                the full list and taking a typed confirmation
  Data is a SEPARATE decision from the tool. Anything a tool recorded is named,
  sized and labelled regenerable-or-not before you are asked, and the default
  answer is NO:
  --purge         delete each tool's MACHINE-WIDE data without asking
  --purge-repo    additionally include THIS repo's data (graphify-out/ and the
                  per-repo indexes). Separate flag on purpose: which repo that
                  means depends on where you are standing, so --purge alone
                  never deletes it. Rows marked [THIS REPO] need this.
  --keep-data     keep all of it without asking
  Unregenerable stores, called out by name: rtk's history.db (your savings
  record), context-mode's index, token-savior's recall store, claude-mem's
  captured sessions, and graphify's config. A repo's graphify-out/ and the
  per-repo graphs ARE regenerable, but a deep semantic re-run costs hours.

Updating (see docs/UPDATING.md):
  agent-tools update all        graphify + claude-mem + every installed tool + self
  agent-tools update tools      only the optional tools (skips graphify/memory/self)
  agent-tools update memory     just claude-mem, and restart its worker
  agent-tools update pocock     just the mattpocock skills
  agent-tools update graphify   just that one (same for rtk, caveman, pocock,
                                superpowers, context-mode, code-review-graph,
                                token-savior, self)
  Nothing is INSTALLED by an update: a tool you do not have is reported, not
  added.

MCP servers (per repo, opt-in since 3.4.0):
  agent-tools init              no server. The agent uses the CLI.
  agent-tools init --add-mcp    add graphify's server to THIS repo
  agent-tools wire NAME         add one later (graphify|crg|token-savior)
  agent-tools unwire NAME       take it back out; the CLI keeps working

  PRO of an MCP server: the agent SEES the tools in every session and reaches
  for them unprompted. No instruction file has to teach it. For a graph you
  query constantly, that is worth paying for.
  CON: it re-sends its whole schema EVERY session whether you call it or not
  (graphify ~1.5k tokens; code-review-graph ships 30 tools), it only works in
  Claude Code, and stacking two or three of them multiplies the tax to answer
  questions you ask one of them.

  Same binary either way. `uv tool install graphifyy` puts BOTH `graphify`
  (CLI) and `graphify-mcp` (server) on disk, reading the same graph.json, so
  wiring installs nothing and unwiring removes nothing. It is reversible on any
  repo at any time.

  Re-running `init` on a repo that already has a server LEAVES IT ALONE.

Scope:
  --project       install/activate for THIS REPO only. Binaries are still
                  shared (brew/uv/npm have no per-project form); what changes
                  is where the hook, plugin and MCP entries land.
                  Does NOT apply to the skill packs (caveman, pocock): skills
                  live in ~/.agents/skills, one copy for every repo and every
                  agent, so those install machine-wide whatever you pass.

Flags (refresh):
  --code-only     AST only, zero LLM, ~1 min
  (default)       code + docs/images semantic pass + community naming
  --deep          as default, but aggressive inferred-edge extraction.
                  Separate cache namespace: the first deep run re-reads
                  every doc. Hours on a large corpus.
  --detach        run in the background, surviving the terminal. Combines
                  with the others: `refresh --deep --detach`.

Memory backend (install-machine):
  --memory=claude-mem   default. light worker on :37701, context injection
  --memory=none         graphify only, nothing captures sessions
  Your choice is remembered in ~/.config/agent-tools/config.
  (--memory=agentmemory was removed in 3.3.0. A config that still names it
   falls back to claude-mem with a notice; the old store is left alone.)

Flags (install-machine):
  --no-caveman          skip the caveman output-compression skill
  --no-rtk              skip rtk and its Bash hook
  --no-superpowers      skip the superpowers skills library
  --no-context-mode     skip context-mode (also skipped on Node < 22.5)
  --no-pocock           skip the mattpocock skill pack
  -y, --yes       install everything missing without asking (CI / unattended)
      --no-install  never install; just report what is missing
  default         ask before each install; skips (never hangs) when
                  non-interactive

Platforms: macOS · Linux · WSL2 = full.  Native Windows = no rtk (see help).

New machine:   agent-tools install-machine
New project:   cd ~/code/myrepo && agent-tools init
Day to day:    agent-tools refresh
USAGE
}

long_help() {
cat <<'HELP'
PLATFORMS

  macOS    full. Nothing to supervise — claude-mem runs its own worker.
  Linux    full. No systemd unit is written any more; `loginctl enable-linger`
           is no longer needed for memory.
  WSL2     full, with or without systemd. Before 3.3.0 a systemd-less WSL had
           no way to supervise the memory server; that server is gone.
  Windows  graphify, claude-mem, superpowers, context-mode and the skill packs
           all work. rtk is the gap: no scoop/winget package, so you need Rust
           (`cargo install --git`) or the release zip on PATH. WSL2 remains the
           smoother route, but is no longer required.

           HISTORICAL: releases before 3.3.0 said "Windows = graphify only".
           That was an agentmemory limitation (no engine installer, and
           `agentmemory connect` unsupported there). Removing that backend
           removed the blocker.

THE THREE TIERS

  agent-tools init             code only (AST). Free, ~1 min. What a new
                               project gets, so setup never turns into a
                               surprise multi-hour LLM job.
  agent-tools refresh          code + docs + images, then community naming.
                               Incremental: you pay only for docs you edited.
  agent-tools refresh --deep   same, with aggressive inferred-edge extraction.
                               Its cache is a separate namespace, so the first
                               deep run re-reads every doc regardless of what a
                               standard pass already cached.
  scripts/graphify-full-run.sh deep, detached, with retry-on-rate-limit and
                               self-termination. Use this instead of --deep
                               when the corpus is big enough to run for hours.

WHY EACH DEFAULT EXISTS  (all observed 2026-07-28)

graphify
  * Code NEVER goes through an LLM. Extraction with Opus, Sonnet, Haiku and
    --mode deep produced byte-identical code graphs. Only docs/images cost
    tokens. So `graphify update .` is free; doc extraction is the paid part.
  * LAW: labels run LAST, and only via `graphify label`. Labels are keyed to a
    clustering, so anything that changes the graph invalidates them.
    `cluster-only` does NOT call the LLM — it renames every community after its
    hub node and exits 0, which looks like success. Measured erosion from single
    out-of-order runs: 501/535, 280/280 and 137/271 communities hub-renamed.
  * Install needs extras. [gemini] is a MISNOMER — it installs the `openai` HTTP
    client + tiktoken, which is exactly what the gemini, openai, kimi AND ollama
    backends all use (they all speak the OpenAI-compatible protocol). Without it
    any of them dies with "the 'openai' package is required". [mcp] is for the
    MCP server. The only backend not covered is `anthropic` (the API-key Claude
    backend) — add it if you ever want that; `claude-cli` needs no package since
    it shells out to the CLI.
  * There is NO codex backend. graphify's list is: claude, claude-cli, gemini,
    openai, kimi, deepseek, ollama, azure, bedrock. A ChatGPT subscription
    cannot drive it, and neither can Antigravity/`agy`.
  * Antigravity replaces the Gemini *CLI* (sunset 2026-06-18), NOT the Gemini
    API. graphify's gemini backend calls generativelanguage.googleapis.com, so
    the CLI sunset does not affect it.
  * LAW: pin mcp<2. graphify 0.9.29 does `from mcp.types import AnyUrl`, removed
    in mcp 2.0.0, and reports the misleading "mcp not installed" when it IS.
  * Hooks must call bare `graphify`, never an absolute path, or they break on
    the next machine.

agentmemory  (REMOVED 3.3.0 — kept here because the reasons are the removal)
  * LAW: the store path was CWD-RELATIVE (v0.9.28: ./data/state_store.db).
    AGENTMEMORY_DATA_DIR and --data-dir were documented but INERT (both tested).
    A service's working directory was the only thing keeping one store. Start
    it somewhere else and you silently got a new, empty one. That single fact
    is why this script used to ship a launchd plist and a systemd unit.
  * LAW: `--tools core` had to be a server ARGUMENT. Neither ~/.agentmemory/.env
    nor the MCP shim's environment honored AGENTMEMORY_TOOLS. As an argument it
    cut 53 tools (~5,918 tokens of schema per session) down to 8 (~995).
  * It had no native-Windows engine installer and `agentmemory connect` was
    unsupported there, which is what pinned this whole script to "Windows =
    graphify only" for three minor versions.
  * If you still have a store: stop the server before copying its files, or the
    live engine overwrites the session index mid-copy. Store files are JSON + an
    8-byte hash/length footer; hand-edit them and the engine rejects the file.
    Never run memory_heal on a freshly restored store — restored observations
    look exactly like the "orphaned" data it deletes.
    `agent-tools memory migrate-from-agentmemory` does all of this correctly.

rtk  (observed 2026-08-04)
  * There are TWO different tools called rtk. crates.io ships an unrelated
    "Rust Type Kit" under the same binary name. `rtk --version` succeeds for
    both, so it is not a test. `rtk gain` exists only on rtk-ai/rtk, which is
    why doctor checks that instead. Homebrew core's `rtk` is the right one.
  * `rtk init -g` PROMPTS ("Patch existing settings.json? [y/N]") and, with no
    terminal attached, answers NO for you, prints a manual step and exits 0.
    Driven from a script it reports success and installs nothing. It also has
    no per-project form and appends an @RTK.md import to your GLOBAL
    CLAUDE.md. So agent-tools writes the hook entry itself, idempotently, at
    the scope you asked for, and can remove it again without disturbing other
    hooks in the same file.

context-mode
  * Needs Node >= 22.5, two majors above this script's floor. On older Node it
    installs fine and every hook then fails at RUNTIME, which reads as a broken
    session rather than a version problem. install-machine checks first.
  * Its session/content store is ~/.claude/context-mode -- that is the
    "continue where I left off" data, and migrate export carries it.

token-savior
  * Extras are NOT remembered across an upgrade. [mcp] is the server,
    [memory-vector] is sqlite-vec + fastembed. Without the second it starts,
    says "vector search disabled" on stderr, and degrades to keyword-only
    recall. Same shape as graphify's [gemini,mcp]: always re-specify.
  * WORKSPACE_ROOTS unset means it auto-discovers every project under your
    home directory -- ten on the machine this was written on, with duplicates.
    `agent-tools wire token-savior` pins it to the repo you are in.
  * `ts` collides with moreutils' `ts` timestamper. Use the full name.
  * `ts init` adds TEN hook entries to the GLOBAL settings.json, one of them a
    PreToolUse/Bash command REWRITER -- the same job rtk does. Two rewriters on
    one command is a debugging problem, not a saving. `wire token-savior`
    registers the MCP server only; doctor flags the pair if you ran it by hand.

Overlap
  * graphify, code-review-graph and token-savior answer the same question.
    Wire ONE per project. An MCP server's tool schema is re-sent every session
    whether or not you call it -- code-review-graph alone is 30 tools.
  * caveman, rtk and context-mode do NOT overlap: they cut what the model
    says, what commands return, and what survives a compaction. Run all three.
  * Full comparison and pick-one guidance: docs/TOOLS.md

MCP scope
  * Project scope (-s local), not user scope. A user-scope entry makes every
    `claude -p` subprocess boot the server (~300 ms each), pure waste for
    scripted fan-out.

Git
  * graphify-out/ is generated. Commit ONLY cache/semantic-deep/ and the label
    files: that is the expensive LLM work, and it makes a fresh clone rebuild
    the graph for free. Everything else is derived output and pure churn.
  * The post-commit hook is OPT-IN (fail closed). It began as opt-out, the
    sentinel vanished, and the hook silently re-enabled itself.
HELP
}

# ---------------------------------------------------------------------------
# Package installation, per platform.
# ---------------------------------------------------------------------------
# Root has no sudo in containers/CI/minimal VMs; non-root without sudo cannot
# install system packages at all. Found by running this on a bare Ubuntu image,
# where `sudo apt-get` failed with "sudo: command not found".
as_root() {
    if [ "$(id -u)" = "0" ]; then "$@"; return; fi
    have sudo || return 127                      # 127 = no sudo at all
    # Passwordless sudo: just go.
    if sudo -n true 2>/dev/null; then sudo "$@"; return; fi
    # Needs a password — only attempt it when stdin is a REAL terminal.
    # `{ : < /dev/tty; }` is not sufficient: over ssh+wsl that open succeeds
    # even with nobody attached, so sudo sat there until "sudo: timed out"
    # (observed on real WSL2 2026-07-29). `[ -t 0 ]` is the honest test.
    if [ -t 0 ]; then sudo "$@"; return; fi
    return 126                                   # 126 = needs password, no tty
}

# Node floor. npm only WARNS about an unmet `engines` field, so a too-old Node
# installs happily and then crash-loops at runtime — the failure mode observed
# on Node 18: "does not provide an export named 'styleText'" (node:util gained
# styleText in 20.12). Ubuntu 24.04 — the most common WSL LTS — ships Node
# 18.19, so this is not a corner case. Observed on a pristine Ubuntu 24.04 WSL2
# distro 2026-07-29. claude-mem and the npm-based tools share this floor.
NODE_MIN=20
node_major() { node -v 2>/dev/null | sed 's/^v//; s/[.].*//'; }
node_ok() { have_native node && [ "$(node_major)" -ge "$NODE_MIN" ] 2>/dev/null; }

# Distro packages are often too old; NodeSource is the usual remedy on
# Debian/Ubuntu. Behind confirm() because it adds a third-party apt repo.
install_node_modern() {
    have apt-get || return 1
    have curl || return 1
    curl -fsSL https://deb.nodesource.com/setup_22.x 2>/dev/null | as_root bash - >/dev/null 2>&1 || return 1
    as_root apt-get install -y nodejs >/dev/null 2>&1
    node_ok
}

install_node() {
    node_ok && return 0
    have_native node && return 0
    case "$PLATFORM" in
        macos) have brew && brew install node ;;
        linux|wsl)
            if   have apt-get; then as_root apt-get update -qq && as_root apt-get install -y nodejs npm
            elif have dnf;     then as_root dnf install -y nodejs npm
            elif have pacman;  then as_root pacman -S --noconfirm nodejs npm
            elif have zypper;  then as_root zypper install -y nodejs npm
            else c_bad "no known package manager — install Node 18+ manually"; return 1; fi
            local rc=$?
            if ! have_native node; then
                case $rc in
                  126) c_warn "sudo needs a password and there is no terminal here."
                       c_warn "Run this yourself, then re-run agent-tools:"
                       c_warn "    sudo apt-get install -y nodejs npm" ;;
                  127) c_warn "no sudo available and not root — install Node yourself." ;;
                  *)   c_warn "node install did not succeed — install it yourself: https://nodejs.org" ;;
                esac
            fi ;;
        windows) c_bad "install Node from https://nodejs.org (or: winget install OpenJS.NodeJS)"; return 1 ;;
    esac
    have_native node
}

install_uv() {
    have uv && return 0
    case "$PLATFORM" in
        macos) have brew && brew install uv && return 0 ;;
    esac
    # Astral's installer is the portable route on Linux/WSL and works on macOS.
    if have curl; then curl -LsSf https://astral.sh/uv/install.sh | sh >/dev/null 2>&1; fi
    export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
    have uv || { c_bad "install uv manually: https://docs.astral.sh/uv/"; return 1; }
}

# ---------------------------------------------------------------------------
# NO SERVICE MANAGEMENT LIVES HERE ANY MORE.
#
# Until 3.3.0 this section built a launchd plist and a systemd --user unit to
# supervise the agentmemory server, because that server stored data relative to
# its WORKING DIRECTORY -- start it from the wrong cwd and you got a silently
# empty store. Two LAWs were encoded in those unit files to survive it.
#
# claude-mem has neither problem: `npx claude-mem start` owns its own worker on
# :37701 and its store path is absolute. So the plist, the unit, the linger
# call, the cwd pinning and the --tools core argument are all gone. If you are
# looking for why a memory server is not running, the answer is now one command
# (`npx claude-mem start`), not a supervisor.
#
# `agent-tools memory migrate-from-agentmemory` cleans up units left behind by
# an older install.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
graph_stats() {
    [ -n "$PY" ] || { echo "python missing"; return; }
    "$PY" -c "
import json
try:
    d=json.load(open('graphify-out/graph.json'))
    print(f\"{len(d['nodes'])} nodes, {len(d['links'])} edges\")
except FileNotFoundError: print('none yet — run: agent-tools init')
except Exception: print('unreadable')" 2>/dev/null
}

doctor() {
    hdr "Platform"
    case "$PLATFORM" in
        macos) c_ok "macOS — full support" ;;
        linux) c_ok "Linux — full support" ;;
        wsl)   c_ok "WSL2 — full support" ;;
        windows) c_warn "native Windows — everything but rtk works; rtk needs Rust or the release zip" ;;
        *) c_warn "unrecognized platform: $(uname -s)" ;;
    esac

    hdr "Machine"
    if node_ok; then c_ok "node $(node -v)"
    elif have_native node; then c_bad "node $(node -v) too old — need >= $NODE_MIN (crash-loops on 18)"
    elif have node; then c_bad "node is the WINDOWS one ($(where_is node)) — install Node inside WSL"
    else c_bad "node missing — run: agent-tools install-machine"; fi
    have uv   && c_ok "uv $(uv --version 2>/dev/null | awk '{print $2}')" || c_bad "uv missing"
    if [ -n "$PY" ]; then c_ok "python: $PY"
    else c_bad "no working python — 'uv python install' fixes it (Windows: python3 is often a Store stub)"; fi
    if have graphify; then
        c_ok "graphify $(graphify --version 2>/dev/null | awk '{print $2}')"
        local gpy="$HOME/.local/share/uv/tools/graphifyy/bin/python"
        [ -x "$gpy" ] || gpy="$(command -v python3)"
        if "$gpy" -c "import mcp.types as t; raise SystemExit(0 if hasattr(t,'AnyUrl') else 1)" 2>/dev/null; then
            c_ok "graphify MCP deps OK (mcp<2 pinned)"
        else
            c_warn "graphify-mcp unavailable — fix: uv tool install \"graphifyy[gemini,mcp]\" --with \"mcp<2\" --force"
        fi
    else c_bad "graphify missing"; fi
    if [ "$PLATFORM" = wsl ] && have npm && ! have_native npm; then
        c_bad "npm is the WINDOWS one ($(where_is npm)) — 'sudo apt-get install -y nodejs npm' inside WSL"
    fi

    hdr "Memory backend: $MEMORY_BACKEND"
    # agent-tools has not installed agentmemory since 3.3.0, but an upgraded
    # machine can still be running one. Two capturing backends means every tool
    # call fires two hook sets into two stores.
    if am_legacy_active; then
        if cm_active; then
            c_bad "A LEGACY agentmemory is STILL CAPTURING alongside claude-mem."
            c_bad "Double hook overhead on every tool call, duplicated memory."
            c_warn "Retire it (keeps the data, migrates it into claude-mem):"
            c_warn "    agent-tools memory migrate-from-agentmemory"
        else
            c_warn "a legacy agentmemory is running; agent-tools no longer manages it"
            c_warn "    agent-tools memory migrate-from-agentmemory"
        fi
    elif am_legacy_installed; then
        c_ok "legacy agentmemory present but INACTIVE (archive) — no conflict"
        echo "        migrate it when convenient: agent-tools memory migrate-from-agentmemory"
    fi
    case "$MEMORY_BACKEND" in
      claude-mem)
        cm_installed && c_ok "claude-mem installed" || c_bad "claude-mem missing — run: agent-tools install-machine"
        [ -d "$HOME/.claude-mem" ] && c_ok "store: ~/.claude-mem" || c_warn "no store yet at ~/.claude-mem"
        # Correction (2026-07-29): the installer says "Worker autostart skipped
        # — start it manually with npx claude-mem start", so a worker IS wanted.
        # It needs no supervisor, but it does need to be running.
        if curl -sf -m 3 http://127.0.0.1:37701 >/dev/null 2>&1; then
            c_ok "worker responding on :37701"
        else
            c_warn "worker not responding — start it:  npx claude-mem start"
        fi ;;
      none) c_warn "no memory backend selected (--memory=none)" ;;
    esac
    if [ -f "$AT_CONFIG" ]; then
        c_ok "backend choice recorded in $AT_CONFIG (machine-wide, all projects)"
    else
        c_warn "backend not recorded — inheriting the default '$MEMORY_DEFAULT'"
        c_warn "    run 'agent-tools init' in any project to pin it"
    fi

    hdr "caveman (output compression)"
    if caveman_installed; then
        local _lvl; _lvl="$(caveman_level)"
        if [ -n "$_lvl" ]; then
            c_ok "installed and ACTIVE at level '$_lvl'"
            echo "        replies compress from message one; /caveman off to stop"
        else
            c_ok "installed, currently off (/caveman to switch on)"
        fi
        [ -d "$HOME/.agents/skills/caveman" ] \
            && c_ok "global skills present (all agents)" \
            || c_warn "no global skills — non-Claude agents lack it: agent-tools caveman install"
    else
        c_warn "caveman not installed — agent-tools install caveman"
    fi

    hdr "Optional tools"
    local _t
    for _t in rtk superpowers context-mode pocock code-review-graph token-savior; do
        tool_status_line "$_t"
    done
    tools_overlap_warnings

    hdr "Instruction file hygiene"
    # An instruction file is read into context EVERY session, so its size is a
    # permanent tax. Memory backends exist precisely so narrative does not have
    # to live here. Advisory only — this never edits your file.
    local ifile="" f
    for f in CLAUDE.md AGENTS.md .cursorrules; do
        [ -f "$(git rev-parse --show-toplevel 2>/dev/null)/$f" ] && { ifile="$(git rev-parse --show-toplevel)/$f"; break; }
    done
    if [ -z "$ifile" ]; then
        c_warn "no CLAUDE.md / AGENTS.md in this project"
    else
        local lines bytes longest
        lines="$(wc -l < "$ifile" | tr -d ' ')"
        bytes="$(wc -c < "$ifile" | tr -d ' ')"
        longest="$(awk '{print length}' "$ifile" 2>/dev/null | sort -rn | head -1)"
        if [ "$bytes" -gt 10240 ] || [ "$lines" -gt 200 ]; then
            c_bad "$(basename "$ifile"): $lines lines, $((bytes/1024)) KB — this is read EVERY session"
            c_warn "Keep it to build/test/lint commands and hard constraints."
            c_warn "Narrative, history and decisions belong in memory ($MEMORY_BACKEND),"
            c_warn "long-form docs in docs/. Nothing here is edited automatically."
        else
            c_ok "$(basename "$ifile"): $lines lines, $((bytes/1024)) KB — lean"
        fi
        [ "${longest:-0}" -gt 2000 ] && c_warn "longest line is $longest chars — likely a pasted log or status dump"
    fi

    hdr "Project: $(basename "$(pwd)")"
    if git rev-parse --show-toplevel >/dev/null 2>&1; then
        local root; root="$(git rev-parse --show-toplevel)"
        [ -f "$root/graphify-out/graph.json" ] && c_ok "graph: $(graph_stats)" || c_warn "no graph — run: agent-tools init"
        grep -q '"graphify hook-guard' "$root/.claude/settings.json" 2>/dev/null \
            && c_ok "hook-guard wired (portable form)" || c_warn "no hook-guard in .claude/settings.json"
        # `graphify claude install` writes its own "## graphify" section. We write
        # a managed block that already covers it, so running both leaves CLAUDE.md
        # saying the same thing twice -- in the very file we ask to keep lean.
        for _instr in "$root/CLAUDE.md" "$root/AGENTS.md"; do
            [ -f "$_instr" ] || continue
            if grep -q "agent-tools:managed" "$_instr" 2>/dev/null \
               && grep -q "^## graphify$" "$_instr" 2>/dev/null; then
                c_warn "$(basename "$_instr") has BOTH graphify's own section and ours"
                echo "        graphify claude uninstall   # drops its section (keeps our hook-guard)"
            fi
        done
        if [ -f "$root/.git/hooks/post-commit" ] && grep -q graphify "$root/.git/hooks/post-commit" 2>/dev/null; then
            [ -f "$root/.git/graphify-auto-update-ENABLED" ] && c_warn "auto-update ENABLED" || c_ok "auto-update installed, disabled (default)"
        else c_warn "no post-commit hook"; fi
        [ -f "$root/.git/hooks/post-checkout" ] && grep -q graphify "$root/.git/hooks/post-checkout" 2>/dev/null \
            && c_ok "post-checkout hook installed (branch switches)" \
            || c_warn "no post-checkout hook — re-run: agent-tools init"
        if have claude; then
            # Not wired is the DEFAULT since 3.4.0, not a fault: the CLI
            # answers the same questions for no per-session cost.
            claude mcp list 2>/dev/null | grep -q "^graphify" \
                && c_ok "graphify MCP wired (~1.5k tokens every session)" \
                || c_ok "graphify MCP not wired — CLI mode (default, 0 tokens)"
            # claude-mem registers its own MCP entry, so there is nothing for
            # us to wire. The only thing worth reporting is a leftover entry
            # from the agentmemory era, which now points at a server nothing
            # starts.
            if [ "$MEMORY_BACKEND" = claude-mem ]; then
                if claude mcp list 2>/dev/null | grep -q "^agentmemory"; then
                    c_warn "stale agentmemory MCP entry (removed backend, dead server)"
                    echo "        claude mcp remove agentmemory -s local"
                else c_ok "memory MCP: claude-mem registers its own"; fi
            fi
        fi
    else c_warn "not a git repository"; fi
}

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# caveman — output-token compression (https://github.com/JuliusBrussee/caveman)
#
# WHY IT IS PART OF THE DEFAULT INSTALL
#   graphify cuts INPUT tokens (ask the graph instead of reading ten files) and
#   the memory backend cuts re-derivation. Neither touches what the agent SAYS
#   BACK, which on a long session is a large share of the spend. caveman is the
#   third leg: a skill telling the agent to drop filler and pleasantries while
#   keeping technical substance and code verbatim. Upstream measures ~65% fewer
#   output tokens; treat that as their number, not ours.
#
#   It is also the cheapest thing here to reverse: it is instructions, not a
#   service. Nothing runs in the background, and turning it off is one command.
#
# WHAT GETS INSTALLED, AND WHY IN TWO STEPS
#   1. caveman's own installer -> the Claude Code PLUGIN (~/.claude/plugins),
#      whose manifest wires SessionStart + UserPromptSubmit hooks. Those hooks
#      are what make it apply from message one rather than only after you type
#      /caveman.
#   2. `skills add -g` -> ~/.agents/skills/caveman*, symlinked into every other
#      agent's directory (Codex, Cursor, Gemini, Continue, ...).
#
#   Step 2 is NOT redundant. caveman's installer does not pass `-g`, so for
#   non-Claude agents it installs PROJECT-scoped into $PWD/.agents/skills --
#   verified 2026-07-29, it dropped skills into the current directory. Run from
#   a temp dir the install evaporates; run from a repo it litters the repo.
#   Hence: always from a neutral directory, and global scope explicitly.
# ---------------------------------------------------------------------------
CAVEMAN_REPO="JuliusBrussee/caveman"

caveman_level() {          # active level, or empty when off
    local f="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.caveman-active"
    [ -f "$f" ] && tr -d '[:space:]' < "$f" 2>/dev/null
}

caveman_installed() {
    [ -d "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/cache/caveman" ] \
        || [ -d "$HOME/.agents/skills/caveman" ]
}

install_caveman() {
    hdr "caveman (output-token compression)"
    if [ "$SKIP_CAVEMAN" = 1 ]; then c_warn "skipped (--no-caveman)"; return 0; fi
    if ! node_ok; then
        c_warn "needs Node >= 18 — skipping caveman (everything else still works)"
        return 0
    fi
    if caveman_installed && [ "$ASSUME_YES" = 0 ] && [ "$NO_INSTALL" = 1 ]; then
        c_ok "caveman already installed (left as-is)"; return 0
    fi
    caveman_installed || confirm "caveman (fewer output tokens; instructions only, no service)" || return 0

    # Run from a directory we do not care about: the upstream installer writes
    # $PWD/.agents/skills for non-Claude agents.
    local neutral; neutral="$(mktemp -d 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")"
    ( cd "$neutral" && npx -y "github:$CAVEMAN_REPO" --non-interactive >/dev/null 2>&1 ) \
        && c_ok "caveman installed for Claude Code (plugin + session hooks)" \
        || c_warn "caveman plugin install failed (network? Node?)"

    # Global, cross-agent. Eve and PromptScript reject global scope by design;
    # that is their limitation and not an error worth surfacing.
    # skills_copy_flag prints an empty string or --copy; splitting is the point.
    # shellcheck disable=SC2046
    ( cd "$neutral" && npx -y skills add "$CAVEMAN_REPO" --skill '*' --agent '*' -g -y $(skills_copy_flag) >/dev/null 2>&1 ) \
        && c_ok "caveman skills installed globally (~/.agents/skills, all agents)" \
        || c_warn "global skill install failed — run: npx -y skills add $CAVEMAN_REPO --all -g"
    [ -d "$neutral" ] && rm -rf "$neutral" 2>/dev/null

    local lvl; lvl="$(caveman_level)"
    if [ -n "$lvl" ]; then
        c_ok "caveman is ACTIVE at level '$lvl' — replies compress from message one"
    else
        c_ok "installed but idle — run /caveman in a session to switch it on"
    fi
    echo "        levels: lite | full | ultra | wenyan     off: /caveman off"
}

caveman_cmd() {
    case "${1:-status}" in
        install) SKIP_CAVEMAN=0; install_caveman ;;
        status)
            if caveman_installed; then
                local lvl; lvl="$(caveman_level)"
                c_ok "caveman installed${lvl:+ — ACTIVE at level '$lvl'}"
                [ -z "$lvl" ] && c_ok "currently off"
                if [ -d "$HOME/.agents/skills/caveman" ]; then
                    local _n=0 _d
                    for _d in "$HOME"/.agents/skills/*caveman*; do [ -e "$_d" ] && _n=$((_n+1)); done
                    c_ok "global skills: $_n present"
                fi
                echo
                echo "  In a session:  /caveman [lite|full|ultra|wenyan]   ·   /caveman off"
                echo "  Savings:       /caveman-stats  (upstream's estimate, not measured here)"
            else
                c_warn "not installed — agent-tools caveman install"
            fi ;;
        update|upgrade)
            node_ok || { c_bad "needs Node >= 18"; return 1; }
            local neutral; neutral="$(mktemp -d 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")"
            ( cd "$neutral" && npx -y "github:$CAVEMAN_REPO" --non-interactive --force >/dev/null 2>&1 ) \
                && c_ok "caveman plugin updated" || c_warn "plugin update failed"
            ( cd "$neutral" && npx -y skills update caveman -g -y >/dev/null 2>&1 ) \
                && c_ok "global caveman skills updated" || c_warn "skill update failed"
            rm -rf "$neutral" 2>/dev/null ;;
        uninstall|remove)
            node_ok || { c_bad "needs Node >= 18"; return 1; }
            local neutral; neutral="$(mktemp -d 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")"
            ( cd "$neutral" && npx -y "github:$CAVEMAN_REPO" --uninstall >/dev/null 2>&1 ) \
                && c_ok "caveman removed from Claude Code" || c_warn "uninstall reported a problem"
            ( cd "$neutral" && npx -y skills remove caveman -g -y >/dev/null 2>&1 ) >/dev/null 2>&1
            rm -rf "$neutral" 2>/dev/null
            c_ok "done — restart your agent for it to take effect" ;;
        *) c_bad "usage: agent-tools caveman [status|install|update|uninstall]"; return 2 ;;
    esac
}

# ===========================================================================
# OPTIONAL TOOLS
#
# Five tools beyond graphify + memory + caveman. Three are installed by
# default because they cost nothing per session beyond their own overhead and
# help on every repo; two are OPT-IN because they duplicate graphify and each
# other, and stacking three code-graph MCP servers loads three tool schemas
# into every single session — the exact tax this project exists to avoid.
#
#   rtk            DEFAULT. Rust CLI proxy. A PreToolUse hook rewrites every
#                  Bash call so `git status`, `cargo test`, `ls` etc. return
#                  filtered output. Cuts INPUT tokens from command results.
#   superpowers    DEFAULT. Skills library (TDD, debugging, planning). Costs
#                  nothing until a skill is invoked.
#   context-mode   DEFAULT. MCP server + hooks: sandboxes tool output, keeps
#                  session state across compaction. Needs Node >= 22.5.
#   pocock         DEFAULT. Four skills from mattpocock/skills, installed
#                  globally so every agent gets them, not just Claude Code.
#                  NOT an MCP server: a skill is a markdown file, so the only
#                  standing cost is its `description` line in the skill index
#                  (~100 tokens for all four). Bodies load on invocation.
#   code-review-graph  OPT-IN. Second code knowledge graph, 30 MCP tools.
#   token-savior       OPT-IN. Third code graph + its own memory engine.
#
# WHY OPT-IN IS NOT A JUDGEMENT ON QUALITY
#   graphify, code-review-graph and token-savior answer the same question --
#   "what is in this codebase and what touches what" -- with different
#   trade-offs. Running two is defensible if you have a reason. Running all
#   three by default is not, because every MCP server's schema is re-sent
#   every session whether or not you call it. docs/TOOLS.md has the
#   side-by-side and the pick-one guidance.
#
# SCOPE
#   Binaries are machine-wide by construction: brew, uv and npm have no
#   per-project form. `--project` changes where the ACTIVATION lands so other
#   repos are untouched:
#     hook       <repo>/.claude/settings.json   instead of ~/.claude/...
#     plugin     --scope project                instead of --scope user
#     MCP        already `-s local` in both cases
# ===========================================================================
RTK_REPO="rtk-ai/rtk"
# rtk uses the OS config directory, not XDG everywhere, so this differs per
# platform. It holds filters.toml AND history.db -- the savings record behind
# `rtk gain`, which is the one thing here that cannot be regenerated. Kept
# HOME-relative because `migrate export` archives from $HOME.
# NOTE the space in the macOS path: anything consuming this list must be
# newline-delimited, never word-split.
case "$PLATFORM" in
    macos) RTK_CONF_REL="Library/Application Support/rtk" ;;
    *)     RTK_CONF_REL=".config/rtk" ;;
esac
RTK_INSTALL_SH="https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh"
SUPERPOWERS_MARKET="anthropics/claude-plugins-official"
SUPERPOWERS_PLUGIN="superpowers@claude-plugins-official"
CONTEXT_MODE_MARKET="mksglu/context-mode"
CONTEXT_MODE_PLUGIN="context-mode@context-mode"
# context-mode's bundle uses APIs added in Node 22.5. Installing it on Node 20
# succeeds and then every hook fails at runtime, which looks like a broken
# session rather than a version problem.
CONTEXT_MODE_NODE_MIN=22
CRG_PKG="code-review-graph"
TS_PKG="token-savior-recall"
# [mcp] is the server; [memory-vector] is sqlite-vec + fastembed. Without the
# second one token-savior starts, says "vector search disabled" on stderr and
# silently degrades to keyword-only recall.
TS_EXTRAS="token-savior-recall[mcp,memory-vector]"

# ---------------------------------------------------------------------------
# pocock — https://github.com/mattpocock/skills
#
# WHICH FOUR, AND WHY NOT THE OTHER 31
#   The repo ships 35 skills. We install the four that are useful in ANY repo
#   and carry no house style with them. The rest (tdd, code-review, to-spec,
#   domain-modeling ...) encode a specific way of working and overlap with
#   superpowers, which is already a default. Install those by hand if you want
#   them:  npx -y skills add mattpocock/skills --skill <name> -g
#
#   grill-me    interviews you one question at a time until every branch of a
#               plan is resolved. User-invoked only.
#   grilling    LAW: grill-me is a two-line stub whose entire body is "Call the
#               Skill tool with 'grilling'". Install grill-me WITHOUT grilling
#               and you get a skill that fires and then dead-ends. They ship as
#               separate directories, so nothing upstream enforces this.
#   handoff     compacts the conversation into a handoff document for the next
#               agent. User-invoked only.
#   wait-what   re-pitches a message that did not land, in Simplified Technical
#               English. User-invoked only.
#
# CONTEXT COST
#   grill-me, handoff and wait-what all set `disable-model-invocation: true`,
#   so the model can never fire them on its own -- they cost one description
#   line each and nothing more. `grilling` does NOT set it, by design: it is
#   what grill-me delegates to, and it also auto-fires on "grill" phrasing.
POCOCK_REPO="mattpocock/skills"
# Newline-delimited, not space-delimited: consumed one per --skill flag.
POCOCK_SKILLS="grill-me
grilling
handoff
wait-what"

OPTIONAL_TOOLS="rtk superpowers context-mode caveman pocock code-review-graph token-savior"
DEFAULT_TOOLS="rtk superpowers context-mode caveman pocock"

# Repo root, or empty when we are not in one.
repo_root() { git rev-parse --show-toplevel 2>/dev/null; }

# Which settings.json a hook should be written to, honouring --project.
hook_settings_file() {
    if [ "$SCOPE_PROJECT" = 1 ]; then
        local r; r="$(repo_root)"
        [ -n "$r" ] || return 1
        printf '%s/.claude/settings.json' "$r"
    else
        printf '%s/settings.json' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    fi
}
plugin_scope() { [ "$SCOPE_PROJECT" = 1 ] && printf 'project' || printf 'user'; }

# ---------------------------------------------------------------------------
# Hook editing.
#
# WHY WE PATCH settings.json OURSELVES INSTEAD OF RUNNING `rtk init -g`
#   `rtk init -g` PROMPTS ("Patch existing settings.json? [y/N]") and, when it
#   cannot read a terminal, DEFAULTS TO NO and prints a manual step -- then
#   exits 0. Verified 2026-08-04 on macOS: the command "succeeded", the hook
#   was never installed, and only the printed text said so. Anything driving
#   it from a script would report success and leave rtk inert.
#   It also has no --project form, and it appends an `@RTK.md` import to your
#   global CLAUDE.md, which is a machine-wide edit we should not make on
#   someone's behalf when they asked for one repo.
#   So: we add the same hook entry ourselves, idempotently, at the scope asked
#   for, and we can remove it again.
# ---------------------------------------------------------------------------
hook_edit() {   # hook_edit add|remove <settings.json> <event> <matcher> <command>
    local action="$1" file="$2" event="$3" matcher="$4" cmd="$5"
    [ -n "$PY" ] || { c_bad "no working python — cannot edit $file"; return 1; }
    mkdir -p "$(dirname "$file")" 2>/dev/null
    ACTION="$action" FILE="$file" EVENT="$event" MATCHER="$matcher" CMD="$cmd" \
    "$PY" - <<'PYEOF'
import json, os, sys

action, path = os.environ["ACTION"], os.environ["FILE"]
event, matcher, cmd = os.environ["EVENT"], os.environ["MATCHER"], os.environ["CMD"]

try:
    with open(path) as fh:
        data = json.load(fh)
except FileNotFoundError:
    data = {}
except (json.JSONDecodeError, OSError) as exc:
    # Never clobber a settings file we cannot parse -- that is someone's
    # whole Claude Code configuration.
    print(f"unreadable: {exc}", file=sys.stderr)
    raise SystemExit(2)
if not isinstance(data, dict):
    print("settings.json is not an object", file=sys.stderr)
    raise SystemExit(2)

hooks = data.setdefault("hooks", {})
entries = hooks.setdefault(event, [])

def has(entry):
    return any(h.get("command") == cmd for h in entry.get("hooks", []))

changed = False
if action == "add":
    if any(e.get("matcher") == matcher and has(e) for e in entries):
        raise SystemExit(3)                      # 3 = already present
    for e in entries:
        if e.get("matcher") == matcher:
            e.setdefault("hooks", []).append({"type": "command", "command": cmd})
            changed = True
            break
    else:
        entries.append({"matcher": matcher,
                        "hooks": [{"type": "command", "command": cmd}]})
        changed = True
else:
    for e in list(entries):
        kept = [h for h in e.get("hooks", []) if h.get("command") != cmd]
        if len(kept) != len(e.get("hooks", [])):
            changed = True
        # An entry whose only hook we just removed is dead weight; drop it.
        # Entries that never had our hook are left exactly as they were.
        if kept:
            e["hooks"] = kept
        else:
            entries.remove(e)
    if not entries:
        hooks.pop(event, None)
    if not hooks:
        data.pop("hooks", None)

if changed:
    tmp = path + ".agent-tools.tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.replace(tmp, path)
raise SystemExit(0)
PYEOF
}

hook_present() {   # hook_present <settings.json> <command>
    [ -f "$1" ] || return 1
    [ -n "$PY" ] || return 1
    FILE="$1" CMD="$2" "$PY" - <<'PYEOF' 2>/dev/null
import json, os, sys
try:
    with open(os.environ["FILE"]) as fh:
        data = json.load(fh)
except Exception:
    raise SystemExit(1)
cmd = os.environ["CMD"]
for entries in (data.get("hooks") or {}).values():
    for e in entries:
        for h in e.get("hooks", []):
            if h.get("command") == cmd:
                raise SystemExit(0)
raise SystemExit(1)
PYEOF
}

# ---------------------------------------------------------------------------
# rtk — https://github.com/rtk-ai/rtk
#
# NAME COLLISION (the reason for the verify step)
#   `rtk` on crates.io is a DIFFERENT project (Rust Type Kit). Both install a
#   binary called rtk. `rtk --version` prints a version for either, so it is
#   not a test. `rtk gain` only exists on this one, so that is the test --
#   the same check upstream documents.
#   Homebrew's core `rtk` formula IS this project (homepage rtk-ai.app,
#   verified 2026-08-04), so brew is safe on macOS.
# ---------------------------------------------------------------------------
RTK_HOOK_CMD="rtk hook claude"

rtk_installed() { have rtk; }
rtk_is_right_one() { have rtk && rtk gain >/dev/null 2>&1; }
# Where rtk keeps config + the savings history DB. Platform-specific because
# it uses the OS config dir, not XDG everywhere.
rtk_config_dir() { printf '%s/%s' "$HOME" "$RTK_CONF_REL"; }

install_rtk() {
    hdr "rtk (Bash output compression)"
    if [ "$SKIP_RTK" = 1 ]; then c_warn "skipped (--no-rtk)"; return 0; fi

    if rtk_installed; then
        c_ok "rtk $(rtk --version 2>/dev/null | awk '{print $2}') present"
    elif ! confirm "rtk (filters Bash output before it reaches the model)"; then
        return 0
    else
        case "$PLATFORM" in
            macos)
                if have brew; then
                    brew install rtk >/dev/null 2>&1 && c_ok "rtk installed (brew)" \
                        || c_bad "brew install rtk failed"
                fi ;;
            linux|wsl)
                # Installs to ~/.local/bin, which we already put on PATH above.
                if have curl; then
                    curl -fsSL "$RTK_INSTALL_SH" | sh >/dev/null 2>&1 \
                        && c_ok "rtk installed (upstream install.sh -> $BIN)" \
                        || c_warn "install.sh failed"
                else c_warn "curl missing — cannot fetch the installer"; fi ;;
            windows)
                # No install.sh path on native Windows. cargo builds from the
                # right repo, which also sidesteps the crates.io name clash.
                if have cargo; then
                    cargo install --git "https://github.com/$RTK_REPO" >/dev/null 2>&1 \
                        && c_ok "rtk installed (cargo, from $RTK_REPO)" \
                        || c_bad "cargo install failed"
                else
                    c_warn "native Windows: download rtk-x86_64-pc-windows-msvc.zip from"
                    c_warn "    https://github.com/$RTK_REPO/releases  and put rtk.exe on PATH"
                    c_warn "    (or install Rust and re-run — cargo builds it from source)"
                    return 0
                fi ;;
        esac
        # Universal fallback for anything the cases above could not do.
        if ! rtk_installed && have cargo; then
            cargo install --git "https://github.com/$RTK_REPO" >/dev/null 2>&1 \
                && c_ok "rtk installed (cargo fallback)"
        fi
        rtk_installed || { c_bad "rtk not installed"; return 1; }
    fi

    if ! rtk_is_right_one; then
        c_bad "the rtk on PATH is NOT rtk-ai/rtk — \`rtk gain\` is not a command there"
        c_bad "    found: $(where_is rtk)"
        c_warn "    that is probably 'Rust Type Kit' from crates.io. Fix:"
        c_warn "    cargo uninstall rtk && cargo install --git https://github.com/$RTK_REPO"
        return 1
    fi
    c_ok "verified: \`rtk gain\` responds (this is rtk-ai/rtk, not the crates.io one)"
    rtk_hook install
}

rtk_hook() {   # rtk_hook install|remove
    local f; f="$(hook_settings_file)" || {
        c_bad "--project needs a git repository"; return 1; }
    case "$1" in
      install)
        if hook_present "$f" "$RTK_HOOK_CMD"; then
            c_ok "hook already in $(printf '%s' "$f" | sed "s|^$HOME|~|")"
        elif hook_edit add "$f" PreToolUse Bash "$RTK_HOOK_CMD"; then
            c_ok "PreToolUse/Bash hook added to $(printf '%s' "$f" | sed "s|^$HOME|~|")"
            echo "        restart Claude Code, then test with:  git status"
        else
            case $? in
              3) c_ok "hook already present" ;;
              *) c_bad "could not patch $f (left untouched)"; return 1 ;;
            esac
        fi ;;
      remove)
        hook_edit remove "$f" PreToolUse Bash "$RTK_HOOK_CMD" \
            && c_ok "rtk hook removed from $(printf '%s' "$f" | sed "s|^$HOME|~|")" \
            || c_warn "could not edit $f"
        # Claude Code MERGES user and project settings. A project file can add
        # a hook; it cannot cancel one declared at user scope -- there is no
        # negation. So removing the project entry while a machine-wide entry
        # exists changes nothing, and silently succeeding would teach someone
        # that this repo is opted out when it is not.
        if [ "$SCOPE_PROJECT" = 1 ] \
           && hook_present "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" "$RTK_HOOK_CMD"; then
            c_bad "rtk is STILL ACTIVE here: the hook is also in ~/.claude/settings.json,"
            c_bad "and project settings merge with user settings — they cannot cancel them."
            c_warn "To run rtk in some repos only, remove it machine-wide first:"
            c_warn "    agent-tools uninstall rtk        # then: install rtk --project per repo"
        fi ;;
    esac
}

update_rtk() {
    rtk_installed || { c_warn "rtk not installed — agent-tools install rtk"; return 0; }
    case "$PLATFORM" in
        macos) have brew && { brew upgrade rtk >/dev/null 2>&1; c_ok "rtk $(rtk --version 2>/dev/null | awk '{print $2}')"; return 0; } ;;
    esac
    if have curl && [ "$PLATFORM" != windows ]; then
        curl -fsSL "$RTK_INSTALL_SH" | sh >/dev/null 2>&1 \
            && c_ok "rtk $(rtk --version 2>/dev/null | awk '{print $2}')" \
            || c_warn "rtk update failed"
    elif have cargo; then
        cargo install --git "https://github.com/$RTK_REPO" --force >/dev/null 2>&1 \
            && c_ok "rtk $(rtk --version 2>/dev/null | awk '{print $2}')" \
            || c_warn "rtk update failed"
    else c_warn "no updater available for rtk on this platform"; fi
}

uninstall_rtk() {
    rtk_hook remove
    if [ "$SCOPE_PROJECT" = 1 ]; then
        c_ok "binary left installed (--project removes the hook only)"; return 0
    fi
    case "$PLATFORM" in
        macos) have brew && brew uninstall rtk >/dev/null 2>&1 && c_ok "rtk removed (brew)" ;;
        *) have cargo && cargo uninstall rtk >/dev/null 2>&1 && c_ok "rtk removed (cargo)" \
             || { rm -f "$BIN/rtk" 2>/dev/null && c_ok "removed $BIN/rtk"; } ;;
    esac
    c_warn "config kept: $(rtk_config_dir) (history.db is your savings record)"
}

# ---------------------------------------------------------------------------
# Claude Code plugins (superpowers, context-mode).
#
# Both are marketplace plugins, so one pair of helpers covers them. The
# marketplace must be added before install or the plugin name does not
# resolve; adding one that is already present is a no-op, so it is safe to
# always do it.
# ---------------------------------------------------------------------------
# PERF LAW: `claude plugin list` takes seconds, not milliseconds. This helper
# is called once per plugin per command, and the inventory calls it for every
# feature -- shelling out each time turned `agent-tools status` into a
# multi-minute hang. Read the list once per process and reuse it. The cache is
# per-invocation, so it cannot go stale within a run that changes nothing.
plugin_installed() {   # plugin_installed <name@marketplace>
    have claude || return 1
    plugin_list_cached 2>/dev/null | grep -q "^  ❯ $1$" && return 0
    plugin_list_cached 2>/dev/null | grep -qF "$1"
}

# Say something true when --project meets a plugin that is ALREADY installed
# machine-wide. Installing it again at project scope changes nothing -- user
# scope already covers every repo -- and silently doing nothing looks like the
# flag was ignored.
plugin_scope_note() {  # plugin_scope_note <name@marketplace>
    [ "$SCOPE_PROJECT" = 1 ] || return 0
    claude plugin list 2>/dev/null | grep -A2 -F "$1" | grep -qi 'Scope: user' || return 0
    c_warn "already installed at USER scope, which covers this repo too."
    c_warn "    --project changed nothing. To confine it, remove the user-scope"
    c_warn "    copy first:  claude plugin uninstall $1"
}

plugin_add() {         # plugin_add <marketplace-repo> <name@marketplace> <label>
    local market="$1" plugin="$2" label="$3"
    have claude || { c_warn "claude CLI not found — cannot install $label"; return 1; }
    claude plugin marketplace add "$market" >/dev/null 2>&1
    if claude plugin install "$plugin" --scope "$(plugin_scope)" >/dev/null 2>&1; then
        c_ok "$label installed (scope: $(plugin_scope))"
    else
        c_bad "$label install failed — try: claude plugin install $plugin"
        return 1
    fi
}

install_superpowers() {
    hdr "superpowers (skills library)"
    if [ "$SKIP_SUPERPOWERS" = 1 ]; then c_warn "skipped (--no-superpowers)"; return 0; fi
    if plugin_installed "$SUPERPOWERS_PLUGIN"; then
        c_ok "superpowers already installed"; plugin_scope_note "$SUPERPOWERS_PLUGIN"; return 0
    fi
    confirm "superpowers (TDD / debugging / planning skills; idle until invoked)" || return 0
    plugin_add "$SUPERPOWERS_MARKET" "$SUPERPOWERS_PLUGIN" "superpowers"
}

install_context_mode() {
    hdr "context-mode (tool-output sandbox + session continuity)"
    if [ "$SKIP_CONTEXT_MODE" = 1 ]; then c_warn "skipped (--no-context-mode)"; return 0; fi
    if ! have_native node || [ "$(node_major)" -lt "$CONTEXT_MODE_NODE_MIN" ] 2>/dev/null; then
        local _nv; _nv="$(node -v 2>/dev/null)"; _nv="${_nv:-none}"
        c_warn "needs Node >= $CONTEXT_MODE_NODE_MIN.5 (have $_nv) — skipping"
        c_warn "its hooks fail at RUNTIME on older Node, which reads as a broken session"
        return 0
    fi
    if plugin_installed "$CONTEXT_MODE_PLUGIN"; then
        c_ok "context-mode already installed"; plugin_scope_note "$CONTEXT_MODE_PLUGIN"; return 0
    fi
    confirm "context-mode (MCP + hooks; adds a second PreToolUse/Bash hook next to rtk)" || return 0
    plugin_add "$CONTEXT_MODE_MARKET" "$CONTEXT_MODE_PLUGIN" "context-mode"
}

update_plugin() {      # update_plugin <name@marketplace> <label>
    have claude || { c_warn "claude CLI not found"; return 0; }
    plugin_installed "$1" || { c_warn "$2 not installed"; return 0; }
    claude plugin marketplace update >/dev/null 2>&1
    claude plugin update "$1" >/dev/null 2>&1 \
        && c_ok "$2 updated (restart Claude Code to apply)" \
        || c_warn "$2 update failed — try: claude plugin update $1"
}

uninstall_plugin() {   # uninstall_plugin <name@marketplace> <label>
    have claude || { c_warn "claude CLI not found"; return 0; }
    claude plugin uninstall "$1" >/dev/null 2>&1 \
        && c_ok "$2 uninstalled" || c_warn "$2 uninstall failed"
}

# ---------------------------------------------------------------------------
# code-review-graph and token-savior — OPT-IN.
#
# Both are Python, both install through uv (already a hard requirement here),
# so they are platform-agnostic in the same way graphify is. Both expose an
# MCP server we wire at PROJECT scope only, for the same reason graphify is
# project-scoped: a user-scope entry makes every `claude -p` subprocess boot
# the server.
#
# Their INDEXES are per-repo and generated, so wiring also adds the ignore
# rule -- committing a rebuildable SQLite graph is pure churn.
# ---------------------------------------------------------------------------
crg_installed() { have code-review-graph; }
ts_installed()  { have token-savior; }

install_crg() {
    hdr "code-review-graph (second knowledge graph — opt-in)"
    have uv || { c_bad "uv is required"; return 1; }
    if crg_installed; then
        c_ok "code-review-graph $(uv_tool_version "$CRG_PKG") present"
    else
        confirm "code-review-graph (30 MCP tools — read docs/TOOLS.md on overlap first)" || return 0
        uv tool install "$CRG_PKG" >/dev/null 2>&1 \
            && c_ok "code-review-graph installed" || { c_bad "install failed"; return 1; }
    fi
    c_warn "30 MCP tools is a large per-session schema. Wire it only where you"
    c_warn "want it:  cd <repo> && agent-tools wire code-review-graph"
    local r; r="$(repo_root)"
    [ -n "$r" ] && confirm "wiring it into $(basename "$r") now" && wire_crg
    return 0
}

wire_crg() {
    local r; r="$(repo_root)" || { c_bad "not a git repository"; return 1; }
    crg_installed || { c_bad "not installed — agent-tools install code-review-graph"; return 1; }
    have claude || { c_bad "claude CLI not found"; return 1; }
    if claude mcp list 2>/dev/null | grep -q "^code-review-graph"; then
        c_ok "code-review-graph MCP already wired here"
    else
        claude mcp add code-review-graph -s local -- code-review-graph mcp --repo "$r" >/dev/null 2>&1 \
            && c_ok "code-review-graph MCP wired (project scope, 30 tools)" \
            || { c_bad "claude mcp add failed"; return 1; }
    fi
    grep -q '^\.code-review-graph/' "$r/.gitignore" 2>/dev/null || {
        printf '\n# code-review-graph index (generated, rebuildable)\n.code-review-graph/\n' >> "$r/.gitignore"
        c_ok "ignored .code-review-graph/"; }
    hdr "Building its graph (local parse, no LLM)"
    ( cd "$r" && code-review-graph build 2>&1 | tail -3 )
}

unwire_crg() {
    have claude || return 1
    claude mcp remove code-review-graph -s local >/dev/null 2>&1 \
        && c_ok "code-review-graph MCP removed from this project" \
        || c_warn "no code-review-graph MCP entry here"
}

install_ts() {
    hdr "token-savior (third knowledge graph + its own memory — opt-in)"
    have uv || { c_bad "uv is required"; return 1; }
    if ts_installed; then
        c_ok "token-savior present"
    else
        confirm "token-savior (overlaps BOTH graphify and your memory backend)" || return 0
        uv tool install "$TS_EXTRAS" >/dev/null 2>&1 \
            && c_ok "token-savior installed (with vector recall)" \
            || { c_bad "install failed"; return 1; }
    fi
    # `ts` is a real collision: moreutils ships a `ts` timestamper, and both
    # land in a PATH directory. Say so rather than letting someone wonder why
    # `ts` prints timestamps.
    if have ts && ! ts --help 2>&1 | grep -q 'find-dead-code'; then
        c_warn "\`ts\` on PATH is NOT token-savior's ($(where_is ts)) — moreutils has one too."
        c_warn "    use the full name: token-savior"
    fi
    c_warn "it also runs a memory engine. Running it alongside $MEMORY_BACKEND means"
    c_warn "two stores of the same sessions — see docs/TOOLS.md before wiring."
    local r; r="$(repo_root)"
    [ -n "$r" ] && confirm "wiring it into $(basename "$r") now" && wire_ts
    return 0
}

wire_ts() {
    local r; r="$(repo_root)" || { c_bad "not a git repository"; return 1; }
    ts_installed || { c_bad "not installed — agent-tools install token-savior"; return 1; }
    have claude || { c_bad "claude CLI not found"; return 1; }
    if claude mcp list 2>/dev/null | grep -q "^token-savior"; then
        c_ok "token-savior MCP already wired here"; return 0
    fi
    # WORKSPACE_ROOTS pinned to this repo. Left unset it auto-discovers every
    # project under your home directory -- observed finding 10 on this machine,
    # including duplicates -- and indexes all of them.
    claude mcp add token-savior -s local \
        -e "WORKSPACE_ROOTS=$r" \
        -e TOKEN_SAVIOR_CLIENT=claude-code \
        -e TOKEN_SAVIOR_PROFILE=optimized \
        -- token-savior >/dev/null 2>&1 \
        && c_ok "token-savior MCP wired (project scope, pinned to this repo)" \
        || { c_bad "claude mcp add failed"; return 1; }
}

unwire_ts() {
    have claude || return 1
    claude mcp remove token-savior -s local >/dev/null 2>&1 \
        && c_ok "token-savior MCP removed from this project" \
        || c_warn "no token-savior MCP entry here"
}

